+    void set_dp_room_prepare(std::function<bool(void* room, std::string& err)> prepare) { dp_room_prepare_ = std::move(prepare); }
     /// Read [pos0, pos0 + n) on `a` and `b` together in chunks of up to `chunk` tokens; the last chunk runs on `b` (the
     /// drafter's GPU) and is at least `min_last` tokens when the prompt allows.  `b`'s on_chunk reports b's chunks.
     static bool run_dp(Prefill& a, Prefill& b, const int64_t* tokens, int64_t n, int64_t pos0, int64_t chunk,
@@ -368,6 +375,7 @@ private:
     // DP: see set_dp
     Prefill* dp_peer_ = nullptr;
     core::SessionState* dp_foreign_ = nullptr;
+    std::function<bool(void*, std::string&)> dp_room_prepare_;   // [claude] STRATA_DP_LAZY (set_dp_room_prepare)
     int64_t dp_own_lb_ = 0, dp_own_le_ = 0;
     std::shared_ptr<DpLink> dp_link_;
     int dp_index_ = 0;
@@ -377,6 +385,13 @@ private:
     bool dp_active_ = false;
     bool dp_wait(int64_t l, int64_t k, std::string& err);
     bool dp_publish(int64_t l, int64_t k, int64_t p0, int64_t T, std::string& err);
+    // [claude] STRATA_DP_STAGE_W=N (opt-in; a DP read beside a stage-trimmed peer): the peer's big dense rows of each
+    // foreign layer copied into N local VRAM slots a layer or two ahead, instead of read in place over the link
+    struct DpWStage;
+    std::shared_ptr<DpWStage> dpw_;
+    void dpw_begin();
+    bool dpw_layer(int64_t l, std::string& err);
+    void dpw_end();
     std::vector<int> tap_layers_;
     std::vector<int> tap_local_;                  ///< the tapped layers this stage runs (run)
     int64_t tap_first_ = 0, tap_cap_ = 0;
diff --git a/src/core/weights.cpp b/src/core/weights.cpp
index 4ff0e5e5..d8eebc45 100644
--- a/src/core/weights.cpp
+++ b/src/core/weights.cpp
@@ -511,10 +511,17 @@ bool WeightTable::load(const std::string& pack_dir, void* arena_base, uint64_t a
 }
 
 const WeightRef* WeightTable::find(const std::string& name) const {
+    if (!dp_staged_.empty()) {   // [claude] STRATA_DP_STAGE_W: a staged copy of a foreign layer's row
+        const auto st = dp_staged_.find(name);
+        if (st != dp_staged_.end()) return &st->second;
+    }
     const auto it = table_.find(name);
     const WeightRef* r = it == table_.end() ? nullptr : &it->second;
     if (dp_fallback_ != nullptr && (r == nullptr || (r->data == nullptr && r->native_data == nullptr && r->hc_q8 == nullptr))) {
-        const WeightRef* o = dp_fallback_->find(name);
+        // the other table's own row only: both tables point at each other during a DP read, so a name neither holds
+        // would otherwise recurse until the stack overflows (SIGSEGV)
+        const auto ot = dp_fallback_->table_.find(name);
+        const WeightRef* o = ot == dp_fallback_->table_.end() ? nullptr : &ot->second;
         if (o != nullptr && (o->data != nullptr || o->native_data != nullptr || o->hc_q8 != nullptr)) return o;
     }
     return r;
