             if (l > LB) pf_step("reading the prompt (batched, step sync): the experts and the rest of layer", l - 1);
             core::progress_at("reading the prompt (batched): layer", l, p0);   // #251: a stall names layer and chunk
+            if (dp && !dpw_layer(l, err)) return false;   // [claude] STRATA_DP_STAGE_W: the foreign layer's copy, the next ones issued
             const core::LayerView v(*m.wt, l);
             if (dp && dp_k > 0 && !dp_wait(l, dp_k, err)) return false;   // DP: chunk k-1's state of layer l
             // STRATA_KVA: `kva_layer` means this layer's output has no consumer left for this chunk, so only its
@@ -7905,19 +7922,263 @@ core::PleRun& dp_ple_of(core::SessionState& own, core::SessionState* foreign) {
 }
 }  // namespace
 
+// [claude] STRATA_DP_STAGE_W=N (opt-in, N >= 2 slots): DP beside a stage-trimmed peer reads each foreign layer's weights from the
+// other card.  Read in place (the fallback) every GEMM pulls them over the link and the BF16 products re-read them per tile: on
+// PCIe 4.0 x8 that loses (E662b).  Here a foreign layer's big rows (>= 256 KiB: the native projections and the BF16
+// hyper-connection / router / indexer matrices) are copied once into one of N local slots, on a copy stream of their own, up
+// to N-1 foreign layers ahead in run order (wrapping to the next chunk's first).  The layer's compute waits for its copy, and a
+// slot is overwritten only after the layer it held has been read (`used`, recorded on the compute stream when the next layer
+// starts).  The weights do not change during a read, so a layer still in a slot from an earlier chunk is not copied again.
+// The small rows (norms, gates) stay read in place.  The slots are allocated for one read and freed after it.
+struct Prefill::DpWStage {
+    struct Seg { const void* src; uint64_t off, bytes; };
+    struct Ref { std::string name; core::WeightRef r; int64_t data_off = -1, native_off = -1; };
+    struct Layer { std::vector<Seg> segs; std::vector<Ref> refs; uint64_t bytes = 0; };
+    std::vector<Layer> L;
+    std::vector<int64_t> order;   // the staged layers, in run order
+    bool planned = false, active = false;
+    int n = 0, dev = 0, peer_dev = -1;
+    uint64_t slot_bytes = 0;
+    uint8_t* base = nullptr;
+    std::vector<int64_t> held;    // the layer in each slot (-1: none)
+    std::vector<uint64_t> seq;    // when each slot was last filled or asked for
+    uint64_t next_seq = 1;
+    std::vector<cudaEvent_t> copied, used;
+    cudaStream_t cp = nullptr;
+    int prev_slot = -1;           // the slot of the layer last entered (its `used` is recorded at the next entry)
+    uint64_t copies = 0, hits = 0, bytes_copied = 0;
+    // [claude] STRATA_DP_STAGE_TIMING=1: per copy (on cp: before / after) and per wait of the compute stream (before / after)
+    struct Tm { cudaEvent_t a, b; uint64_t bytes; };
+    std::vector<Tm> tcopy, twait;
+};
+static bool dpw_timing_env() {
+    static const bool v = [] { const char* e = std::getenv("STRATA_DP_STAGE_TIMING"); return e != nullptr && e[0] == '1'; }();
+    return v;
+}
+static bool dpw_ev2(cudaEvent_t& a, cudaEvent_t& b) {
+    return cudaEventCreate(&a) == cudaSuccess && cudaEventCreate(&b) == cudaSuccess;
+}
+
+static int dpw_slots_env() {
+    static const int v = [] { const char* e = std::getenv("STRATA_DP_STAGE_W"); return e != nullptr ? std::max(0, std::atoi(e)) : 0; }();
+    return v;
+}
+
+void Prefill::dpw_begin() {
+    Impl& m = *impl_;
+    const int ns = dpw_slots_env();
+    if (ns < 2 || m.wt == nullptr || m.wt->dp_fallback() == nullptr || m.g == nullptr || dp_peer_ == nullptr) return;
+    if (!dpw_) dpw_ = std::make_shared<DpWStage>();
+    DpWStage& S = *dpw_;
+    const core::WeightTable& own = *m.wt;
+    const core::WeightTable& peer = *own.dp_fallback();
+    const int64_t nl = m.g->n_layers;
+    if (!S.planned) {
+        S.L.assign((size_t) nl, DpWStage::Layer{});
+        std::map<std::string, std::pair<int64_t, uint64_t>> skipped;   // [claude] STRATA_DP_STAGE_TIMING
+        void* scratch = nullptr;   // this table's native q8_1 scratch: a staged row must not point at the peer's
+        for (const auto& [nm, r] : own.all())
+            if (r.native_q8_1 != nullptr) { scratch = r.native_q8_1; break; }
+        // [claude] STRATA_DP_STAGE_MIN=<bytes> (default 256 KiB): rows below it stay on the peer (read in place); 0 stages every row
+        static const uint64_t kMin = [] { const char* e = std::getenv("STRATA_DP_STAGE_MIN"); return e != nullptr ? (uint64_t) std::max(0LL, std::atoll(e)) : (uint64_t) (256u << 10); }();
+        for (const auto& [nm, o] : peer.all()) {
+            if (nm.rfind("blk.", 0) != 0) continue;
+            const int64_t l = std::atoll(nm.c_str() + 4);
+            if (l < 0 || l >= nl) continue;
+            const auto it = own.all().find(nm);
+            if (it != own.all().end() && (it->second.data != nullptr || it->second.native_data != nullptr || it->second.hc_q8 != nullptr))
+                continue;   // this card's own row
+            const uint64_t nb = o.native_data != nullptr && o.native_type >= 0
+                                    ? strata::kernels::native_mmvq_weight_bytes(o.native_type, (int) o.ne0, (int) o.ne1) : 0;
+            const uint64_t cb = o.data != nullptr ? o.bytes : 0;
+            if (o.hc_q8 != nullptr || o.q8_scale != nullptr || ((nb == 0 || nb < kMin) && (cb == 0 || cb < kMin))) {   // read in place over the link
+                if (dpw_timing_env()) {   // [claude] STRATA_DP_STAGE_TIMING: what stays on the peer, by the row's name past blk.N.
+                    const size_t d2 = nm.find('.', 4);
+                    const std::string kind = (o.hc_q8 != nullptr ? "hc_q8:" : o.q8_scale != nullptr ? "q8_scale:" : "small:") +
+                                             (d2 == std::string::npos ? nm : nm.substr(d2 + 1));
+                    auto& e = skipped[kind]; e.first += 1; e.second += std::max(nb, cb);
+                }
+                continue;
+            }
+            DpWStage::Layer& Ly = S.L[(size_t) l];
+            DpWStage::Ref R{nm, o};
+            auto add = [&](const void* src, uint64_t b) -> int64_t {
+                const uint64_t off = Ly.bytes;
+                Ly.segs.push_back({src, off, b});
+                Ly.bytes = (off + b + 255) / 256 * 256;
+                return (int64_t) off;
+            };
+            if (cb > 0 && cb >= kMin) R.data_off = add(o.data, cb);
+            if (nb > 0 && nb >= kMin) { R.native_off = add(o.native_data, nb); R.r.native_q8_1 = scratch; }
+            Ly.refs.push_back(std::move(R));
+        }
+        uint64_t tot = 0;
+        for (int64_t l = 0; l < nl; ++l)
+            if (!S.L[(size_t) l].segs.empty()) {
+                S.order.push_back(l);
+                S.slot_bytes = std::max(S.slot_bytes, S.L[(size_t) l].bytes);
+                tot += S.L[(size_t) l].bytes;
+            }
+        for (const auto& [k, v] : skipped)   // [claude] STRATA_DP_STAGE_TIMING
+            std::fprintf(stderr, "strata prefill DP: CUDA%d reads in place: %s x%lld (%.2f MiB)\n", m.device, k.c_str(),
+                         (long long) v.first, v.second / 1048576.0);
+        S.planned = true;
+        std::fprintf(stderr, "strata prefill DP: CUDA%d stages %zu foreign layers' big rows (%.0f MiB in all, %.1f MiB a slot) "
+                             "in %d local slots (STRATA_DP_STAGE_W)\n", m.device, S.order.size(), tot / 1048576.0,
+                     S.slot_bytes / 1048576.0, ns);
+    }
+    if (S.order.empty()) return;
+    S.dev = m.device;
+    S.peer_dev = dp_peer_->impl_->device;
+    const core::OnDevice on(S.dev);
+    S.n = std::min<int>(ns, (int) S.order.size());
+    void* b = nullptr;
+    if (cudaMalloc(&b, (size_t) S.n * S.slot_bytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        static std::atomic<bool> said{false};
+        if (!said.exchange(true))
+            std::fprintf(stderr, "strata prefill DP: CUDA%d has no room for %d staging slots (%.0f MiB): the foreign layers are "
+                                 "read in place\n", S.dev, S.n, S.n * S.slot_bytes / 1048576.0);
+        return;
+    }
+    S.base = (uint8_t*) b;
+    if (S.cp == nullptr && cudaStreamCreateWithFlags(&S.cp, cudaStreamNonBlocking) != cudaSuccess) {
+        (void) cudaGetLastError();
+        cudaFree(b);
+        S.base = nullptr;
+        return;
+    }
+    while ((int) S.copied.size() < S.n) {
+        cudaEvent_t e1 = nullptr, e2 = nullptr;
+        cudaEventCreateWithFlags(&e1, cudaEventDisableTiming);
+        cudaEventCreateWithFlags(&e2, cudaEventDisableTiming);
+        S.copied.push_back(e1);
+        S.used.push_back(e2);
+    }
+    S.held.assign((size_t) S.n, -1);
+    S.seq.assign((size_t) S.n, 0);
+    S.next_seq = 1;
+    S.prev_slot = -1;
+    S.copies = S.hits = S.bytes_copied = 0;
+    for (int i = 0; i < S.n; ++i) cudaEventRecord(S.used[(size_t) i], m.cs);   // a fresh slot has no reader
+    S.active = true;
+}
+
+bool Prefill::dpw_layer(int64_t l, std::string& err) {
+    if (!dpw_ || !dpw_->active) return true;
+    DpWStage& S = *dpw_;
+    Impl& m = *impl_;
+    if (S.prev_slot >= 0) {   // the layer before: every read of its slot is on the stream now
+        cudaEventRecord(S.used[(size_t) S.prev_slot], m.cs);
+        S.prev_slot = -1;
+    }
+    const auto at = std::find(S.order.begin(), S.order.end(), l);
+    if (at == S.order.end()) return true;   // one of this card's own layers
+    const size_t pos = (size_t) (at - S.order.begin());
+    auto ensure = [&](int64_t x, int64_t keep) -> int {
+        for (int i = 0; i < S.n; ++i)
+            if (S.held[(size_t) i] == x) { ++S.hits; S.seq[(size_t) i] = S.next_seq++; return i; }
+        int v = -1;   // the oldest slot not holding `keep` (the layer about to run); an empty slot first
+        for (int i = 0; i < S.n; ++i)
+            if (S.held[(size_t) i] != keep && (v < 0 || S.seq[(size_t) i] < S.seq[(size_t) v])) v = i;
+        if (v < 0) return -1;
+        if (S.held[(size_t) v] >= 0)
+            for (const auto& R : S.L[(size_t) S.held[(size_t) v]].refs) m.wt->dp_stage_drop(R.name);
+        S.held[(size_t) v] = -1;
+        uint8_t* dst = S.base + (size_t) v * S.slot_bytes;
+        if (cudaStreamWaitEvent(S.cp, S.used[(size_t) v], 0) != cudaSuccess) return -1;
+        DpWStage::Tm tm{nullptr, nullptr, S.L[(size_t) x].bytes};
+        const bool timed = dpw_timing_env() && dpw_ev2(tm.a, tm.b);
+        if (timed) cudaEventRecord(tm.a, S.cp);
+        for (const auto& sg : S.L[(size_t) x].segs)
+            if (cudaMemcpyPeerAsync(dst + sg.off, S.dev, sg.src, S.peer_dev, sg.bytes, S.cp) != cudaSuccess) return -1;
+        if (timed) { cudaEventRecord(tm.b, S.cp); S.tcopy.push_back(tm); }
+        if (cudaEventRecord(S.copied[(size_t) v], S.cp) != cudaSuccess) return -1;
+        for (const auto& R : S.L[(size_t) x].refs) {
+            core::WeightRef r = R.r;
+            if (R.data_off >= 0) r.data = dst + R.data_off;
+            if (R.native_off >= 0) r.native_data = dst + R.native_off;
+            m.wt->dp_stage_put(R.name, r);
+        }
+        S.held[(size_t) v] = x;
+        S.seq[(size_t) v] = S.next_seq++;
+        ++S.copies;
+        S.bytes_copied += S.L[(size_t) x].bytes;
+        return v;
+    };
