 include/strata/prefill/prefill.hpp |  15 ++
 src/core/weights.cpp               |   9 +-
 src/prefill/prefill.cpp            | 315 +++++++++++++++++++++++++++++
 src/program/generate.cpp           |  78 ++++++-
 5 files changed, 420 insertions(+), 5 deletions(-)

diff --git a/include/strata/core/weights.hpp b/include/strata/core/weights.hpp
index cf0d5b3f..6e926285 100644
--- a/include/strata/core/weights.hpp
+++ b/include/strata/core/weights.hpp
@@ -142,6 +142,13 @@ public:
     /// DP prefill (STRATA_DP_PREFILL): while the other GPU's table is set, a row this table skipped (a stage-trimmed layer:
     /// no data, no native or Q8 copy) is that table's row - device pointers the peer link reads.  nullptr clears it.
     void set_dp_fallback(const WeightTable* other) const { dp_fallback_ = other; }
+    const WeightTable* dp_fallback() const { return dp_fallback_; }
+    /// [claude] STRATA_DP_STAGE_W (Prefill::DpWStage): rows of the other card's foreign layers copied into this card's
+    /// staging slots, found before the table's own rows and the fallback.  Only the thread reading this table's prompt
+    /// touches them (a DP read has no decode beside it).
+    void dp_stage_put(const std::string& name, const WeightRef& r) const { dp_staged_[name] = r; }
+    void dp_stage_drop(const std::string& name) const { dp_staged_.erase(name); }
+    void dp_stage_clear() const { dp_staged_.clear(); }
     /// STRATA_HC_Q8: the hyper-connection projections (`blk.*.hc_{attn,ffn}_{down,up}.weight`) the loader SKIPPED
     /// are read from the pack, quantized to int8 + one fp32 scale per 32 values, and uploaded to their own device
     /// allocation (`q8_scale` set).  Returns the bytes uploaded in `bytes`.
@@ -155,6 +162,7 @@ private:
     friend class NativeDense;
     std::map<std::string, WeightRef> table_;
     mutable const WeightTable* dp_fallback_ = nullptr;
+    mutable std::map<std::string, WeightRef> dp_staged_;
     LoadReport report_;
     std::string pack_dir_;
 };
