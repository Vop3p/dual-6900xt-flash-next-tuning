     m.ple_norm = o.take<float>((size_t) strata::kernels::NG_HC_DIM, ok);
     take_stage(o, ss, s, m.stage, ok);
+    {   // [claude] STRATA_DP_LAZY: the foreign session's room, last (bytes_needed_impl takes it last too)
+        const uint64_t room = dp_room_of(&ss);
