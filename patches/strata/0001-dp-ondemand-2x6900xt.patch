 // Every device buffer of a chunk of T tokens, from the Alloc `alloc` (after the GEMM scratch and workspace): `init`
 // once, and `relayout` for a request's own chunk.  The order is `bytes_needed`'s.
+// [claude] STRATA_DP_LAZY: the DP foreign session's bytes per prompt path (keyed by the path's session), taken last by
+// bytes_needed_impl and carve (Prefill::set_dp_room)
+namespace {
+std::map<const core::SessionState*, uint64_t>& dp_rooms() { static std::map<const core::SessionState*, uint64_t> m; return m; }
+uint64_t dp_room_of(const core::SessionState* ss) { const auto it = dp_rooms().find(ss); return it == dp_rooms().end() ? 0 : it->second; }
+}  // namespace
+void Prefill::set_dp_room(const core::SessionState* owner, uint64_t bytes) { dp_rooms()[owner] = bytes; }
+bool Prefill::dp_room_ready() const { return impl_ && impl_->dp_room != nullptr; }
