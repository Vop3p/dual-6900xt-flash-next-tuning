diff --git a/include/strata/hip_compat/vram_ledger.h b/include/strata/hip_compat/vram_ledger.h
new file mode 100644
index 000000000..320e71fbb
--- /dev/null
+++ b/include/strata/hip_compat/vram_ledger.h
@@ -0,0 +1,210 @@
+// [claude] E721: every cudaMalloc / cudaFree of a HIP build goes through here (cuda_runtime.h maps the names), so the
+// engine keeps its own VRAM ledger by source location without touching the call sites. It only records: the same
+// hipMalloc / hipFree run with the same arguments in the same order.
+//   seal(when)    print each card's ledger (tracked bytes by file:line, the untracked rest = runtime, libraries and
+//                 other processes) and mark the end of loading; a cudaMalloc after it prints one line per site
+//                 ("post-seal allocation", 1 MiB or more) - STRATA_VRAM_STRICT=1 aborts instead (tests).
+//   report(when)  the same table without sealing.  STRATA_VRAM_LEDGER=0 prints nothing (the counting stays).
+#pragma once
+#define STRATA_VRAM_LEDGER 1
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <vector>
+
+namespace strata::vram {
+
+struct Site { long long live = 0, peak = 0, total = 0; int n_live = 0, n_all = 0; };
+struct State {
+    std::mutex mu;
+    struct Rec { int dev; size_t bytes; const char* file; int line; };
+    std::unordered_map<void*, Rec> live;
+    std::map<std::tuple<int, std::string, int>, Site> sites;   // (device, file, line)
+    long long dev_live[64] = {};
+    bool sealed = false;
+    std::map<std::tuple<int, std::string, int>, long long> mark_live[64];   // [claude] E724: each site's live bytes at mark_cache(dev)
+    bool marked[64] = {};
+    long long free_at_mark[64] = {};   // [claude] E724: the card's free VRAM when its cache was sized
+    std::map<std::tuple<int, std::string, int>, bool> post_seal_said;   // (device, file, line)
+};
+inline State& state() { static State* s = new State(); return *s; }   // never destroyed: frees can run at exit
+
+inline const char* short_file(const char* f) {
+    const char* p = std::strstr(f, "/src/");
+    if (p == nullptr) p = std::strstr(f, "/include/");
+    return p != nullptr ? p + 1 : f;
+}
+inline bool print_on() {
+    static const bool v = [] { const char* e = std::getenv("STRATA_VRAM_LEDGER"); return e == nullptr || std::atoi(e) != 0; }();
+    return v;
+}
+
+inline hipError_t tracked_malloc(void** p, size_t bytes, const char* file, int line) {
+    const hipError_t e = hipMalloc(p, bytes);
+    if (e != hipSuccess || p == nullptr || *p == nullptr) return e;
+    int dev = 0;
+    if (hipGetDevice(&dev) != hipSuccess || dev < 0 || dev >= 64) dev = 0;
+    State& s = state();
+    bool say = false, strict = false;
+    {
+        std::lock_guard<std::mutex> lk(s.mu);
+        s.live[*p] = State::Rec{dev, bytes, file, line};
+        Site& st = s.sites[{dev, short_file(file), line}];
+        st.live += (long long) bytes; st.total += (long long) bytes; st.peak = std::max(st.peak, st.live);
+        ++st.n_live; ++st.n_all;
+        s.dev_live[dev] += (long long) bytes;
+        if (s.sealed && bytes >= (1u << 20)) {   // [claude] E722: under 1 MiB (a lazily made record buffer) fits the driver margin
+            auto& said = s.post_seal_said[{dev, short_file(file), line}];
+            say = !said && print_on(); said = true;
+            const char* v = std::getenv("STRATA_VRAM_STRICT");
+            strict = v != nullptr && std::atoi(v) != 0;
+        }
+    }
+    if (say || strict) {
+        std::fprintf(stderr, "strata vram: post-seal allocation %s:%d - %.1f MiB on CUDA%d (not in the ledger the "
+                             "expert cache was sized from)%s\n", short_file(file), line, bytes / 1048576.0, dev,
+                     strict ? "; STRATA_VRAM_STRICT=1: abort" : "");
+        if (strict) std::abort();
+    }
+    return e;
+}
+
+inline hipError_t tracked_free(void* p) {
+    if (p != nullptr) {
+        State& s = state();
+        std::lock_guard<std::mutex> lk(s.mu);
+        const auto it = s.live.find(p);
+        if (it != s.live.end()) {
+            const State::Rec& r = it->second;
+            Site& st = s.sites[{r.dev, short_file(r.file), r.line}];
+            st.live -= (long long) r.bytes; --st.n_live;
+            s.dev_live[r.dev] -= (long long) r.bytes;
+            s.live.erase(it);
+        }
+    }
+    return hipFree(p);
+}
+
+// [claude] E723: memory that does not come from cudaMalloc (VMM chunks: hipMemCreate) - booked under `key` (the handle) so
+// the table and the untracked figure stay right; no post-seal line (the scheduler maps and unmaps chunks on purpose)
+inline void note_alloc(void* key, int dev, size_t bytes, const char* file, int line) {
+    if (key == nullptr) return;
+    if (dev < 0 || dev >= 64) dev = 0;
+    State& s = state();
+    std::lock_guard<std::mutex> lk(s.mu);
+    s.live[key] = State::Rec{dev, bytes, file, line};
+    Site& st = s.sites[{dev, short_file(file), line}];
+    st.live += (long long) bytes; st.total += (long long) bytes; st.peak = std::max(st.peak, st.live);
+    ++st.n_live; ++st.n_all;
+    s.dev_live[dev] += (long long) bytes;
+}
+inline void note_free(void* key) {
+    if (key == nullptr) return;
+    State& s = state();
+    std::lock_guard<std::mutex> lk(s.mu);
+    const auto it = s.live.find(key);
+    if (it == s.live.end()) return;
+    const State::Rec& r = it->second;
+    Site& st = s.sites[{r.dev, short_file(r.file), r.line}];
+    st.live -= (long long) r.bytes; --st.n_live;
+    s.dev_live[r.dev] -= (long long) r.bytes;
+    s.live.erase(it);
+}
+
+// one table per card: tracked live bytes by site (>= 1 MiB, largest first), the tracked total, and the rest of the
+// used VRAM that no cudaMalloc accounts for (the HIP runtime's code objects and context, rocBLAS / hipBLASLt
+// internals, graphs, and any other process on the card)
+inline void report(const char* when) {
+    if (!print_on()) return;
+    State& s = state();
+    int n_dev = 0, cur = 0;
+    if (hipGetDeviceCount(&n_dev) != hipSuccess) return;
+    if (hipGetDevice(&cur) != hipSuccess) cur = 0;
+    std::lock_guard<std::mutex> lk(s.mu);
+    for (int d = 0; d < n_dev && d < 64; ++d) {
+        size_t fr = 0, tot = 0;
+        if (hipSetDevice(d) != hipSuccess || hipMemGetInfo(&fr, &tot) != hipSuccess) continue;
+        std::vector<std::pair<long long, std::string>> rows;
+        long long small = 0;
+        for (const auto& [k, st] : s.sites) {
+            if (std::get<0>(k) != d || st.live <= 0) continue;
+            if (st.live < (1ll << 20)) { small += st.live; continue; }
+            char b[320];
+            std::snprintf(b, sizeof b, "%9.1f MiB  x%-4d %s:%d", st.live / 1048576.0, st.n_live, std::get<1>(k).c_str(), std::get<2>(k));
+            rows.emplace_back(st.live, b);
+        }
+        if (rows.empty() && small == 0) continue;
+        std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+        const long long used = (long long) tot - (long long) fr;
+        std::fprintf(stderr, "strata vram: CUDA%d ledger (%s): %lld MiB tracked by cudaMalloc, %lld MiB used, %lld MiB "
+                             "free of %lld - untracked %lld MiB (HIP runtime, libraries, graphs, other processes)\n",
+                     d, when, s.dev_live[d] >> 20, used >> 20, (long long) (fr >> 20), (long long) (tot >> 20),
+                     (used - s.dev_live[d]) >> 20);
+        for (const auto& r : rows) std::fprintf(stderr, "strata vram: CUDA%d   %s\n", d, r.second.c_str());
+        if (small > 0) std::fprintf(stderr, "strata vram: CUDA%d   %9.1f MiB  (sites under 1 MiB)\n", d, small / 1048576.0);
+    }
+    (void) hipSetDevice(cur);
+}
+
+// [claude] E724: what is allocated on a card after its expert cache was sized from the free VRAM - the part the cache's
+// reserve must cover.  mark_cache(dev) right before the cache opens; seal() then lists every site that grew since.
+inline void mark_cache(int dev) {
+    if (dev < 0 || dev >= 64) return;
+    State& s = state();
+    std::lock_guard<std::mutex> lk(s.mu);
+    s.mark_live[dev].clear();
+    for (const auto& [k, st] : s.sites)
+        if (std::get<0>(k) == dev) s.mark_live[dev][k] = st.live;
+    s.marked[dev] = true;
+    int cur = 0;
+    size_t fr = 0, tot = 0;
+    if (hipGetDevice(&cur) == hipSuccess && hipSetDevice(dev) == hipSuccess && hipMemGetInfo(&fr, &tot) == hipSuccess)
+        s.free_at_mark[dev] = (long long) fr;
+    (void) hipSetDevice(cur);
+}
+inline long long free_at_mark(int dev) { return dev >= 0 && dev < 64 && state().marked[dev] ? state().free_at_mark[dev] : -1; }
+// MiB allocated on `dev` since mark_cache(dev), net of frees (0 when never marked); `print` lists the sites (>= 1 MiB)
+inline long long since_cache_bytes(int dev, bool print, const char* when) {
+    if (dev < 0 || dev >= 64) return 0;
+    State& s = state();
+    std::lock_guard<std::mutex> lk(s.mu);
+    if (!s.marked[dev]) return 0;
+    long long tot = 0;
+    std::vector<std::pair<long long, std::string>> rows;
+    for (const auto& [k, st] : s.sites) {
+        if (std::get<0>(k) != dev) continue;
+        const auto it = s.mark_live[dev].find(k);
+        const long long d = st.live - (it == s.mark_live[dev].end() ? 0 : it->second);
+        if (d == 0) continue;
+        tot += d;
+        if (print && (d >= (1ll << 20) || d <= -(1ll << 20))) {
+            char b[320];
+            std::snprintf(b, sizeof b, "%+9.1f MiB  %s:%d", d / 1048576.0, std::get<1>(k).c_str(), std::get<2>(k));
+            rows.emplace_back(d, b);
+        }
+    }
+    if (print && print_on()) {
+        std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+        std::fprintf(stderr, "strata vram: CUDA%d after the expert cache was sized (%s): %+.1f MiB tracked\n", dev, when, tot / 1048576.0);
+        for (const auto& r : rows) std::fprintf(stderr, "strata vram: CUDA%d   %s\n", dev, r.second.c_str());
+    }
+    return tot;
+}
+
+inline void seal(const char* when) {
+    for (int d = 0; d < 64; ++d)
+        if (state().marked[d]) (void) since_cache_bytes(d, true, when);
+    report(when);
+    std::lock_guard<std::mutex> lk(state().mu);
+    state().sealed = true;
+}
+
+}  // namespace strata::vram
