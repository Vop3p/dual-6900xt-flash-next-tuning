diff --git a/tests/core/expert_cache_vmm_partial_test.cpp b/tests/core/expert_cache_vmm_partial_test.cpp
new file mode 100644
index 000000000..31235f751
--- /dev/null
+++ b/tests/core/expert_cache_vmm_partial_test.cpp
@@ -0,0 +1,175 @@
+// [claude] E723: a VMM expert cache mapped only in part (ExpertCache::set_vmm_map_bytes) and grown later (vmm_grow).
+// The slots mapped at open keep their address and bytes across a grow; the new ones read zero and take writes; the
+// VRAM comes from the device the cache was opened on (a layer split opens one per card).  Exits 77 without VMM.
+#include "strata/core/expert_cache.hpp"
+#include "strata/core/vmm.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace {
+int fail(const char* what, const std::string& err = "") {
+    std::fprintf(stderr, "FAIL %s %s\n", what, err.c_str());
+    return 1;
+}
+size_t free_on(int dev) {
+    int cur = 0;
+    cudaGetDevice(&cur);
+    cudaSetDevice(dev);
+    size_t f = 0, t = 0;
+    cudaMemGetInfo(&f, &t);
+    cudaSetDevice(cur);
+    return f;
+}
+bool fill(strata::core::ExpertCache& c, int64_t from, int64_t to, const std::vector<int64_t>& sz) {
+    for (int64_t i = from; i < to; ++i) {
+        std::vector<uint8_t> b((size_t) sz[(size_t) i], (uint8_t) (i * 7 + 1));
+        if (cudaMemcpy(c.device_slot((int32_t) i), b.data(), b.size(), cudaMemcpyHostToDevice) != cudaSuccess) return false;
+    }
+    return true;
+}
+// slots [from, to): each byte is (i * 7 + 1), or 0 when `zero`
+bool check(const strata::core::ExpertCache& c, int64_t from, int64_t to, const std::vector<int64_t>& sz, bool zero) {
+    for (int64_t i = from; i < to; ++i) {
+        std::vector<uint8_t> b((size_t) sz[(size_t) i]);
+        if (cudaMemcpy(b.data(), c.device_slot((int32_t) i), b.size(), cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+        const uint8_t want = zero ? 0 : (uint8_t) (i * 7 + 1);
+        for (const uint8_t x : b)
+            if (x != want) return false;
+    }
+    return true;
+}
+
+int run_on(int dev, int n_dev) {
+    cudaSetDevice(dev);
+    if (!strata::core::vmm_available()) { std::printf("SKIP: no VMM on device %d\n", dev); return 77; }
+    const int64_t g = (int64_t) strata::core::vmm_granularity();
+    // sized slots like a native pack's: three sizes, 64 slots, ~1.5 MiB each -> ~96 MiB arena
+    std::vector<int64_t> sz;
+    for (int i = 0; i < 64; ++i) sz.push_back(i % 3 == 0 ? (1 << 20) + 4096 : i % 3 == 1 ? (3 << 19) : (1 << 21) - 512);
+    strata::core::ExpertCache::set_vmm(true);
+    strata::core::ExpertCache c;
+    c.set_vmm_map_bytes(16 * g);   // ~32 MiB of ~96
+    const size_t f0 = free_on(dev), fo0 = n_dev > 1 ? free_on(1 - dev) : 0;
+    std::string err;
+    if (!c.open_sized(sz, 4, 64, err)) return fail("open_sized", err);
+    if (!c.vmm_partial()) return fail("not partial after open");
+    const int64_t live0 = c.slots(), full = c.full_slots();
+    std::printf("device %d: %lld of %lld slots mapped (%.1f of %.1f MiB)\n", dev, (long long) live0, (long long) full,
+                c.mapped_bytes() / 1048576.0, c.full_bytes() / 1048576.0);
+    if (live0 <= 0 || live0 >= full) return fail("live slots not a proper prefix");
+    if (c.mapped_bytes() != 16 * g) return fail("mapped bytes != 16 chunks");
+    const size_t f1 = free_on(dev), fo1 = n_dev > 1 ? free_on(1 - dev) : 0;
+    // the 32 MiB came off this device, not the other (2 MiB slack for the runtime's own bookkeeping)
+    if ((int64_t) f0 - (int64_t) f1 < 16 * g - (2 << 20)) return fail("this device's free VRAM did not drop by the mapped part");
+    if (n_dev > 1 && (int64_t) fo0 - (int64_t) fo1 > (8 << 20)) return fail("the other device lost VRAM: the chunks went to the wrong card");
+    if (!check(c, 0, live0, sz, true)) return fail("mapped slots not zeroed");
+    if (!fill(c, 0, live0, sz)) return fail("fill before grow");
+    std::vector<uint8_t*> addr;
+    for (int64_t i = 0; i < live0; ++i) addr.push_back(c.device_slot((int32_t) i));
+    if (!c.vmm_grow(c.full_bytes() + g, err)) return fail("vmm_grow", err);   // past the end: capped at the arena
+    if (c.slots() != full) return fail("not every slot live after a full grow");
+    for (int64_t i = 0; i < live0; ++i)
+        if (c.device_slot((int32_t) i) != addr[(size_t) i]) return fail("a slot moved");
+    if (!check(c, 0, live0, sz, false)) return fail("old slots changed across the grow");
+    if (!check(c, live0, full, sz, true)) return fail("new slots not zero");
+    if (!fill(c, live0, full, sz) || !check(c, 0, full, sz, false)) return fail("new slots not writable");
+    // [claude] E730: shrink to about half and grow again through the generic resizable() interface, with the OTHER
+    // device current (the layer split's main thread resizes a later stage's cache from CUDA0): the prefix keeps its
+    // bytes, the VRAM comes off / goes back to this card only, and the regrown slots read zero and take writes
+    if (!c.resizable()) return fail("a partial VMM cache is not resizable()");
+    const int other = n_dev > 1 ? 1 - dev : dev;
+    const size_t fs0 = free_on(dev), fso0 = n_dev > 1 ? free_on(other) : 0;
+    cudaSetDevice(other);
+    if (!c.shrink(c.full_bytes() / 2, err)) return fail("shrink", err);
+    const int64_t live_s = c.slots();
+    const size_t fs1 = free_on(dev), fso1 = n_dev > 1 ? free_on(other) : 0;
+    if (live_s <= 0 || live_s >= full) return fail("shrink did not leave a proper prefix");
+    if ((int64_t) fs1 - (int64_t) fs0 < c.full_bytes() / 2 - 2 * g - (2 << 20)) return fail("shrink did not give this card's VRAM back");
+    std::printf("device %d: shrink with device %d current: this card free %zu -> %zu MiB, other card %zu -> %zu MiB\n", dev, other,
+                fs0 >> 20, fs1 >> 20, fso0 >> 20, fso1 >> 20);
+    if (n_dev > 1 && std::llabs((long long) fso1 - (long long) fso0) > (8 << 20)) return fail("shrink moved the other card's VRAM");
+    cudaSetDevice(dev);   // the arena is this card's: read it from here
+    if (!check(c, 0, live_s, sz, false)) return fail("the prefix changed across the shrink");
+    cudaSetDevice(other);
+    if (!c.grow(c.full_bytes() + g, err)) return fail("grow after shrink", err);
+    const size_t fs2 = free_on(dev), fso2 = n_dev > 1 ? free_on(other) : 0;
+    if (c.slots() != full) return fail("not every slot live after the regrow");
+    if ((int64_t) fs1 - (int64_t) fs2 < c.full_bytes() / 2 - 2 * g - (2 << 20)) return fail("the regrow did not take this card's VRAM");
+    std::printf("device %d: regrow with device %d current: this card free %zu -> %zu MiB, other card %zu -> %zu MiB\n", dev, other,
+                fs1 >> 20, fs2 >> 20, fso1 >> 20, fso2 >> 20);
+    if (n_dev > 1 && std::llabs((long long) fso2 - (long long) fso1) > (8 << 20)) return fail("the regrow took the other card's VRAM");
+    cudaSetDevice(dev);
+    if (!check(c, 0, live_s, sz, false)) return fail("the prefix changed across the regrow");
+    if (!check(c, live_s, full, sz, true)) return fail("regrown slots not zero");
+    if (!fill(c, live_s, full, sz) || !check(c, 0, full, sz, false)) return fail("regrown slots not writable from this card");
+    std::printf("device %d: shrink %lld -> %lld slots (%zu MiB back), regrow -> %lld (other card moved %lld / %lld MiB)\n", dev,
+                (long long) full, (long long) live_s, (fs1 - fs0) >> 20, (long long) c.slots(),
+                (long long) (((long long) fso1 - (long long) fso0) >> 20), (long long) (((long long) fso2 - (long long) fso1) >> 20));
+    const size_t f2 = free_on(dev);
+    const int64_t full_mapped = c.mapped_bytes();
+    c.close();
+    const size_t f3 = free_on(dev);
+    std::printf("device %d: free MiB before open %zu, after open %zu, grown %zu, after close %zu\n", dev, f0 >> 20, f1 >> 20, f2 >> 20, f3 >> 20);
+    // the arena's chunks come back (f0 is before the runtime's first kernels, whose code objects stay loaded)
+    if ((int64_t) f3 - (int64_t) f2 < full_mapped - (4 << 20)) return fail("close did not give the VRAM back");
+    std::printf("device %d: ok (grown to %lld slots, every old slot in place)\n", dev, (long long) full);
+    return 0;
+}
+}  // namespace
+
+int main() {
+    int n = 0;
+    if (cudaGetDeviceCount(&n) != cudaSuccess || n <= 0) { std::printf("SKIP: no GPU\n"); return 77; }
+    // [claude] E730: every device's runtime context up front, so a later first use of the other card (its context takes
+    // ~150 MiB on HIP 7.1) is not read as the cache moving that card's VRAM
+    for (int d = 0; d < n && d < 2; ++d) {
+        cudaSetDevice(d);
+        void* p = nullptr;
+        cudaMalloc(&p, 1 << 20);
+        cudaMemset(p, 0, 1 << 20);
+        cudaDeviceSynchronize();
+        cudaFree(p);
+    }
+    for (int d = 0; d < n && d < 2; ++d) {
+        const int r = run_on(d, n);
+        if (r != 0) return r;
+    }
+    // [claude] E730: a layer split's prompt path copies between a cache and the other card (DP staging in the loan):
+    // with vmm_set_access_all a peer copy out of a VMM cache reads the cache's bytes; without it (control) it is printed
+    if (n >= 2) {
+        for (int all = 0; all < 2; ++all) {
+            strata::core::vmm_set_access_all(all == 1);
+            cudaSetDevice(0);
+            std::vector<int64_t> sz(16, 1 << 20);
+            strata::core::ExpertCache c;
+            c.set_vmm_map_bytes(1LL << 40);   // all of it
+            std::string err;
+            if (!c.open_sized(sz, 4, 16, err)) return fail("open for the peer copy", err);
+            if (!fill(c, 0, 16, sz)) return fail("fill for the peer copy");
+            cudaSetDevice(1);
+            void* dst = nullptr;
+            cudaMalloc(&dst, 1 << 20);
+            const cudaError_t e = cudaMemcpyPeer(dst, 1, c.device_slot(5), 0, 1 << 20);
+            const cudaError_t s2 = cudaDeviceSynchronize();
+            std::vector<uint8_t> back(1 << 20);
+            cudaMemcpy(back.data(), dst, back.size(), cudaMemcpyDeviceToHost);
+            bool same = e == cudaSuccess && s2 == cudaSuccess;
+            for (const uint8_t x : back) same = same && x == (uint8_t) (5 * 7 + 1);
+            std::printf("peer copy out of a VMM cache, access to every card %s: %s (%s / %s)\n", all ? "on" : "off (control)",
+                        same ? "bytes match" : "WRONG or failed", cudaGetErrorString(e), cudaGetErrorString(s2));
+            (void) cudaGetLastError();
+            cudaFree(dst);
+            cudaSetDevice(0);
+            c.close();
+            if (all == 1 && !same) return fail("a peer copy out of a VMM cache with access to every card");
+        }
+        strata::core::vmm_set_access_all(false);
+    }
+    std::printf("PASS\n");
+    return 0;
+}
