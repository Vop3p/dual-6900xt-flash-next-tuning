+}
+/// MiB to keep free on `dev` after its cache (need + grow + margin), or -1 without a calibration for it
+inline long long reserve_mib(int dev) {
+    const State& s = st();
+    if (!s.on || !s.loaded) return -1;
+    for (const Card& c : s.prev)
+        if (c.dev == dev && c.need >= 0) return (c.need + std::max(0ll, c.grow) + (1ll << 20) - 1) / (1ll << 20) + s.margin_mib;
+    return -1;
+}
+inline void save() {
+    const State& s = st();
+    if (!s.on || s.path.empty() || s.cur.empty()) return;
+    const std::string tmp = s.path + ".tmp";
+    if (FILE* f = std::fopen(tmp.c_str(), "w")) {
+        for (const Card& c : s.cur) std::fprintf(f, "%d %lld %lld\n", c.dev, c.need, c.grow);
+        std::fclose(f);
+        std::rename(tmp.c_str(), s.path.c_str());
+    }
+}
+inline long long free_on(int dev) {
+    int cur = 0; size_t fr = 0, tot = 0;
+    if (cudaGetDevice(&cur) != cudaSuccess) return -1;
+    long long r = -1;
+    if (cudaSetDevice(dev) == cudaSuccess && cudaMemGetInfo(&fr, &tot) == cudaSuccess) r = (long long) fr;
+    (void) cudaSetDevice(cur);
+    return r;
+}
+/// at the seal: what `dev` allocated after its cache (`cache_bytes`) was sized
+inline void at_seal(int dev, long long cache_bytes) {
+    State& s = st();
+    if (!s.on) return;
+#ifdef STRATA_VRAM_LEDGER
+    const long long fm = strata::vram::free_at_mark(dev);
+#else
+    const long long fm = -1;
+#endif
+    const long long fn = free_on(dev);
+    if (fm < 0 || fn < 0) return;
+    Card c;
+    c.dev = dev; c.need = std::max(0ll, fm - fn - cache_bytes); c.seal_free = fn; c.low_free = fn;
+    for (const Card& p : s.prev) if (p.dev == dev) c.grow = std::max(0ll, p.grow);   // kept until this run shows its own
+    s.cur.push_back(c);
+    long long prev_need = -1;
+    for (const Card& p : s.prev) if (p.dev == dev) prev_need = p.need;
+    std::fprintf(stderr, "strata vram: CUDA%d calibration: %lld MiB allocated after the cache was sized (free %lld MiB then, "
+                         "%lld MiB now, cache %lld MiB); the next start keeps %lld MiB free after its cache%s\n", dev, c.need >> 20,
+                 fm >> 20, fn >> 20, cache_bytes >> 20, (c.need + c.grow + (1ll << 20) - 1) / (1ll << 20) + s.margin_mib,
+                 prev_need < 0 ? "" : c.need > prev_need + (16ll << 20) ? " - MORE than the calibration this start was sized from: the margin pays for it" : "");
+}
+/// after a request: the lowest free figure since the seal (the windows' graphs, captured on first use)
+inline void after_request() {
+    State& s = st();
+    if (!s.on || s.cur.empty()) return;
+    bool changed = false;
+    for (Card& c : s.cur) {
+        const long long fr = free_on(c.dev);
+        if (fr >= 0 && fr < c.low_free) {
+            c.low_free = fr;
+            const long long g = c.seal_free - c.low_free;
+            if (g > c.grow) { c.grow = g; changed = true; }
+        }
+    }
+    if (changed) save();
+}
