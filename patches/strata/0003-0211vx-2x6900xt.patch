+
+class SplitElastic(unittest.TestCase):
+    """[claude] E732: on a layer split only the encoder's card makes room, and only that card takes it back."""
+    def setUp(self):
+        d = tempfile.mkdtemp()
+        self.tok = ByteTokenizer()
+        self.engine = SplitVramEngine(self.tok)
