+    check(need_bytes(14000 * MiB, 500 * MiB, 13000 * MiB) == 500 * MiB, "need = mark - now - cache");
+    check(need_bytes(1000 * MiB, 900 * MiB, 200 * MiB) == 0, "need never negative");
+    check(need_bytes(-1, 500, 0) == -1 && need_bytes(500, -1, 0) == -1, "need unknown without both figures");
+
+    // growth: the lowest free figure after any request, and it never shrinks
+    long long grow = 0, low = 500 * MiB;
+    check(update_grow(grow, 500 * MiB, low, 450 * MiB) && grow == 50 * MiB, "a request that lowers free grows it");
+    check(!update_grow(grow, 500 * MiB, low, 480 * MiB) && grow == 50 * MiB, "a higher free figure later changes nothing");
+    check(!update_grow(grow, 500 * MiB, low, -1) && grow == 50 * MiB, "a failed reading changes nothing");
+    long long kept = 80 * MiB, low2 = 500 * MiB;
+    check(!update_grow(kept, 500 * MiB, low2, 450 * MiB) && kept == 80 * MiB, "a growth kept from the file is not lowered");
+
+    // [claude] E771: a measured need far below the calibration is not taken; a rise always is; none and tiny is not written
+    check(judge_need(0, 465 * MiB) == NeedVerdict::KeepPrev, "E769 OFF_5: card 1 measured 0 against 465 MiB - kept");
+    check(judge_need(-300 * MiB, 465 * MiB) == NeedVerdict::KeepPrev, "a negative reading against a calibration - kept");
+    check(judge_need(440 * MiB, 465 * MiB) == NeedVerdict::Take, "a small fall is taken");
+    check(judge_need(200 * MiB, 465 * MiB) == NeedVerdict::KeepPrev, "a fall by more than half and 64 MiB - kept");
+    check(judge_need(40 * MiB, 100 * MiB) == NeedVerdict::Take, "more than half but under 64 MiB - taken");
+    check(judge_need(900 * MiB, 465 * MiB) == NeedVerdict::Take, "a rise is always taken");
+    check(judge_need(0, -1) == NeedVerdict::Skip && judge_need(31 * MiB, -1) == NeedVerdict::Skip, "no calibration, under 32 MiB - skipped");
+    check(judge_need(351 * MiB, -1) == NeedVerdict::Take, "no calibration, a real figure - taken");
+
+    // the margin: a number or a tier, anything else the default
+    check(margin_mib(nullptr) == 192 && margin_mib("") == 192, "unset or empty: the default 192");
+    check(margin_mib("tight") == 96 && margin_mib("normal") == 192 && margin_mib("safe") == 384, "the three tiers");
+    check(margin_mib("256") == 256 && margin_mib("0") == 0, "a number of MiB");
+    check(margin_mib("-5") == 192 && margin_mib("12x") == 192 && margin_mib("huge") == 192, "a bad value falls back to the default");
+
+    if (g_fail == 0) std::printf("vram_calib_test: all checks passed\n");
+    return g_fail == 0 ? 0 : 1;
+}
diff --git a/include/strata/program/vram_ledger.hpp b/include/strata/program/vram_ledger.hpp
new file mode 100644
index 000000000..1a20c359d
--- /dev/null
+++ b/include/strata/program/vram_ledger.hpp
@@ -0,0 +1,214 @@
+// include/strata/program/vram_ledger.hpp - scheduler step 2b: one card's expert-cache lending ledger (no GPU).
+//
+// Every user of a card's expert cache other than the experts themselves declares what it needs - a FIXED address (baked
+// into captured graphs), a RELOCATABLE one (laid out again at each use) or EXTERNAL room (VRAM given back to the driver
+// for another program) - and the ledger decides WHERE, by the three rules the engine already follows (see
+// notes/调度器第2步-借还接口盘点.md):
+//   - fixed regions stack from the head, in the order they are reserved at start; the head never moves, so neither do they;
+//   - relocatable loans take the tail of the slots usable now (`live`); several may be out at once (two batch slots
+//     reading prompts, a prompt loan beside a K/V growth, a small 8-12 GB card where everyone squeezes): each takes the
+//     first gap from the tail that holds it, so the first loan is exactly today's, and a gap a released loan leaves is
+//     reused; a sub-loan is carved inside its parent;
+//   - external room comes off the end (shrink), only while no loan is out past the new end.
+// The ledger only computes slot ranges and checks those rules; evicting, laying out and refilling stay where they are.
+// The tail arithmetic is split_lend_slots (split_ring.hpp), the same function the prompt path's loan uses today, so a
+// borrower moved onto the ledger gets exactly the slots it gets now.
+#pragma once
+
+#include "strata/program/split_ring.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::program::vram_ledger {
+
+enum class Addr { Fixed, Relocatable, External };
+
+struct Lease {
+    int id = -1;
+    std::string name;
+    Addr addr = Addr::Relocatable;
+    int parent = -1;          ///< a sub-loan: the lease it is carved from
+    int64_t lo = 0, hi = 0;   ///< slot range [lo, hi)
+    uint64_t bytes = 0;       ///< what was asked
+    bool active = false;
+};
+
+class Card {
+public:
+    /// `offsets`: the cache's per-slot byte-offset prefix sum (slots + 1 entries) or empty for uniform `max_blob` slots.
+    Card(int64_t slots, std::vector<uint64_t> offsets, uint64_t max_blob)
+        : full_(slots), live_(slots), off_(std::move(offsets)), max_blob_(max_blob) {}
+
+    int64_t full() const { return full_; }
+    int64_t live() const { return live_; }
+    /// The end of the fixed head regions (the first slot a loan may never go below).
+    int64_t head_end() const { return head_end_; }
+    const std::vector<Lease>& leases() const { return leases_; }
+
+    /// The bytes of slots [0, n) (n clamped to the full cache).
+    uint64_t bytes_of(int64_t n) const {
+        if (n <= 0) return 0;
+        if (n > full_) n = full_;
+        return off_.empty() ? (uint64_t) n * max_blob_ : off_[(size_t) n];
+    }
+    /// Slots [0, k) whose bytes cover `need` (the smallest such k), or -1 when the whole cache does not.
+    int64_t head_slots_for(uint64_t need) const {
+        for (int64_t k = 0; k <= full_; ++k)
+            if (bytes_of(k) >= need) return k;
+        return -1;
+    }
+
+    /// A FIXED region at the head, stacked after the ones before it.  Only at start (before any loan or shrink): its
+    /// address is baked into graphs.  `budget_slots`: the most slots the head regions may take together.  -1: refused.
+    int reserve_head(const std::string& name, uint64_t bytes, int64_t budget_slots) {
+        if (any_active(Addr::Relocatable) || live_ != full_) return -1;
+        const int64_t lo = head_end_;
+        int64_t hi = lo;
+        while (hi < full_ && bytes_of(hi) - bytes_of(lo) < bytes) ++hi;
+        if (bytes_of(hi) - bytes_of(lo) < bytes || hi > budget_slots) return -1;
+        head_end_ = hi;
+        const int id = add(name, Addr::Fixed, -1, lo, hi, bytes);
+        leases_.back().active = false;   // placed, not occupied: experts use it until `occupy` (the slot sessions' way)
+        return id;
+    }
+    /// A fixed region in use (its experts evicted) / free again (experts may refill it).  The loan keeps clear of the
+    /// head regions either way: their place is fixed.
+    bool occupy(int id) { return set_fixed(id, true); }
+    bool vacate(int id) { return set_fixed(id, false); }
+
+    /// A RELOCATABLE loan: the first gap from the tail of `live` that holds `bytes`, taken from the gap's high end (the
+    /// tail slots whose bytes cover it; with no other loan out that is split_lend_slots over `live`, today's loan).
+    /// Refused (-1) when no gap holds it without reaching into the head regions, or when the loans together would
+    /// leave the experts fewer than `keep_min` slots past the head regions.  `available` says how much would fit.
+    int lend_tail(const std::string& name, uint64_t bytes, int64_t keep_min) {
+        if (bytes == 0) return -1;
+        const int64_t keep = keep_min > 0 ? keep_min : 0;
+        for (const auto& [glo, ghi] : gaps()) {
+            const int64_t lo = take_from_top(glo, ghi, bytes);
+            if (lo < 0) continue;
+            if (loaned_slots() + (ghi - lo) > live_ - head_end_ - keep) return -1;   // the experts' floor
+            return add(name, Addr::Relocatable, -1, lo, ghi, bytes);
+        }
+        return -1;
+    }
+    /// The most bytes one more loan could get now (the largest gap, within the experts' floor) - for a caller that can
+    /// take less (a smaller prompt chunk on a short card) instead of being refused.
+    uint64_t available(int64_t keep_min) const {
+        const int64_t keep = keep_min > 0 ? keep_min : 0;
+        const int64_t room = live_ - head_end_ - keep - loaned_slots();
+        if (room <= 0) return 0;
+        uint64_t best = 0;
+        for (const auto& [glo, ghi] : gaps()) {
+            const int64_t lo = ghi - room > glo ? ghi - room : glo;
+            const uint64_t b = bytes_of(ghi) - bytes_of(lo);
+            if (b > best) best = b;
+        }
+        return best;
+    }
+
+    /// A sub-loan inside an active relocatable loan, from its low end, after the sub-loans already in it.  -1: no room.
+    int sub(int parent, const std::string& name, uint64_t bytes) {
+        const Lease* p = find(parent);
+        if (p == nullptr || !p->active || p->addr != Addr::Relocatable || p->parent >= 0) return -1;
+        int64_t lo = p->lo;
+        for (const Lease& l : leases_)
+            if (l.active && l.parent == parent && l.hi > lo) lo = l.hi;
+        int64_t hi = lo;
+        while (hi < p->hi && bytes_of(hi) - bytes_of(lo) < bytes) ++hi;
+        if (bytes_of(hi) - bytes_of(lo) < bytes) return -1;
+        return add(name, Addr::Relocatable, parent, lo, hi, bytes);
+    }
+
+    /// EXTERNAL room: keep `keep_slots` usable and give the rest back.  Refused while a loan is out (the engine only
+    /// shrinks between requests) or below the head regions.  Growing back (a larger `keep_slots`) is always allowed up to
+    /// the full cache.
+    bool shrink_to(int64_t keep_slots) {
+        if (keep_slots > full_) keep_slots = full_;
+        if (keep_slots < live_ && (any_active(Addr::Relocatable) || keep_slots < head_end_)) return false;
+        live_ = keep_slots;
+        return true;
+    }
+
+    /// Give a lease back (and the sub-loans inside it).
+    void release(int id) {
+        for (Lease& l : leases_)
+            if (l.id == id || l.parent == id) l.active = false;
+    }
+
+    /// The slots experts may use now: [0, live) minus the occupied head regions and the active loan.
+    int64_t expert_slots() const {
+        int64_t n = live_;
+        for (const Lease& l : leases_)
+            if (l.active && l.parent < 0 && l.addr != Addr::External) n -= l.hi - l.lo;
+        return n;
+    }
+
+private:
+    /// Slots held by the top-level relocatable loans.
+    int64_t loaned_slots() const {
+        int64_t n = 0;
+        for (const Lease& l : leases_)
+            if (l.active && l.addr == Addr::Relocatable && l.parent < 0) n += l.hi - l.lo;
+        return n;
+    }
+    /// The free stretches of [head_end, live) between the top-level loans, from the tail down.
+    std::vector<std::pair<int64_t, int64_t>> gaps() const {
+        std::vector<std::pair<int64_t, int64_t>> busy;
+        for (const Lease& l : leases_)
+            if (l.active && l.addr == Addr::Relocatable && l.parent < 0) busy.emplace_back(l.lo, l.hi);
+        std::sort(busy.begin(), busy.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+        std::vector<std::pair<int64_t, int64_t>> out;
+        int64_t top = live_;
+        for (const auto& [lo, hi] : busy) {
+            if (hi < top) out.emplace_back(hi, top);
+            if (lo < top) top = lo;
+        }
+        if (head_end_ < top) out.emplace_back(head_end_, top);
+        return out;
+    }
+    /// The lowest slot of a run ending at `hi` (inside [glo, hi)) whose bytes cover `need`, or -1.
+    int64_t take_from_top(int64_t glo, int64_t hi, uint64_t need) const {
+        int64_t lo = hi;
+        while (lo > glo && bytes_of(hi) - bytes_of(lo) < need) --lo;
+        return bytes_of(hi) - bytes_of(lo) >= need ? lo : -1;
+    }
+    bool any_active(Addr a) const {
+        for (const Lease& l : leases_)
+            if (l.active && l.addr == a && l.parent < 0) return true;
+        return false;
+    }
+    bool set_fixed(int id, bool on) {
+        for (Lease& l : leases_)
+            if (l.id == id && l.addr == Addr::Fixed) { l.active = on; return true; }
+        return false;
+    }
+    const Lease* find(int id) const {
+        for (const Lease& l : leases_)
+            if (l.id == id) return &l;
+        return nullptr;
+    }
+    int add(const std::string& name, Addr a, int parent, int64_t lo, int64_t hi, uint64_t bytes) {
+        Lease l;
+        l.id = next_id_++;
+        l.name = name;
+        l.addr = a;
+        l.parent = parent;
+        l.lo = lo;
+        l.hi = hi;
+        l.bytes = bytes;
+        l.active = true;
+        leases_.push_back(l);
+        return l.id;
+    }
+
+    int64_t full_ = 0, live_ = 0, head_end_ = 0;
+    std::vector<uint64_t> off_;
+    uint64_t max_blob_ = 0;
+    std::vector<Lease> leases_;
+    int next_id_ = 0;
+};
+
+}  // namespace strata::program::vram_ledger
diff --git a/src/kernels/fetch_rebase_parity.cpp b/src/kernels/fetch_rebase_parity.cpp
new file mode 100644
index 000000000..76ba833f2
--- /dev/null
+++ b/src/kernels/fetch_rebase_parity.cpp
@@ -0,0 +1,79 @@
+// src/kernels/fetch_rebase_parity.cpp - [claude] E763 B5 STRATA_FETCH_REBASE: fetch_blobs_rebase against fetch_blobs then
+// rebase_ptrs, for 0..cap staged blobs from mapped host memory: the staged bytes (memcmp) and the pointers the PCIe share's
+// kernels read afterwards (the rebased src array for the two launches, `out` for the fused one) must be the same.
+#include "strata/kernels/verify_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace {
+void ck(cudaError_t e, const char* w) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", w, cudaGetErrorString(e)); std::exit(1); }
+}
+}  // namespace
+
+int main() {
+    constexpr int CAP = 16;
+    constexpr int64_t BLOB = 1948 * 1024;   // a 16-byte multiple, about the IQ3_S slot
+    cudaStream_t st = nullptr;
+    ck(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking), "stream");
+    std::vector<void*> host(CAP);
+    std::mt19937 rng(5);
+    for (int k = 0; k < CAP; ++k) {
+        ck(cudaHostAlloc(&host[k], BLOB, cudaHostAllocMapped), "hostalloc");
+        auto* b = (uint32_t*) host[k];
+        for (int64_t i = 0; i < BLOB / 4; ++i) b[i] = rng();
+    }
+    std::vector<unsigned long long> srcp(CAP);
+    for (int k = 0; k < CAP; ++k) { void* d = nullptr; ck(cudaHostGetDevicePointer(&d, host[k], 0), "devptr"); srcp[k] = (unsigned long long) d; }
+    unsigned long long *d_src_a = nullptr, *d_src_b = nullptr, *d_out = nullptr;
+    int32_t* d_n = nullptr;
+    uint8_t *d_dst_a = nullptr, *d_dst_b = nullptr;
+    ck(cudaMalloc(&d_src_a, CAP * 8), "m"); ck(cudaMalloc(&d_src_b, CAP * 8), "m"); ck(cudaMalloc(&d_out, CAP * 8), "m");
+    ck(cudaMalloc(&d_n, 4), "m"); ck(cudaMalloc(&d_dst_a, CAP * BLOB), "m"); ck(cudaMalloc(&d_dst_b, CAP * BLOB), "m");
+    int fails = 0;
+    for (int n = 0; n <= CAP; ++n) {
+        ck(cudaMemcpy(d_src_a, srcp.data(), CAP * 8, cudaMemcpyHostToDevice), "h2d");
+        ck(cudaMemcpy(d_src_b, srcp.data(), CAP * 8, cudaMemcpyHostToDevice), "h2d");
+        ck(cudaMemcpy(d_n, &n, 4, cudaMemcpyHostToDevice), "h2d");
+        ck(cudaMemset(d_dst_a, 0x11, CAP * BLOB), "ms"); ck(cudaMemset(d_dst_b, 0x22, CAP * BLOB), "ms"); ck(cudaMemset(d_out, 0, CAP * 8), "ms");
+        ck(cudaDeviceSynchronize(), "sync before");   // the memsets run on the legacy stream, the kernels on `st` (non-blocking)
+        strata::kernels::fetch_blobs(d_src_a, d_n, d_dst_a, BLOB, CAP, st);
+        strata::kernels::rebase_ptrs(d_src_a, d_n, d_dst_a, BLOB, st);
+        strata::kernels::fetch_blobs_rebase(d_src_b, d_n, d_dst_b, BLOB, CAP, d_out, st);
+        ck(cudaStreamSynchronize(st), "sync");
+        std::vector<uint8_t> a((size_t) n * BLOB), b((size_t) n * BLOB);
+        if (n > 0) {
+            ck(cudaMemcpy(a.data(), d_dst_a, a.size(), cudaMemcpyDeviceToHost), "d2h");
+            ck(cudaMemcpy(b.data(), d_dst_b, b.size(), cudaMemcpyDeviceToHost), "d2h");
+        }
+        std::vector<unsigned long long> pa(CAP), pb(CAP), sb(CAP);
+        ck(cudaMemcpy(pa.data(), d_src_a, CAP * 8, cudaMemcpyDeviceToHost), "d2h");
+        ck(cudaMemcpy(pb.data(), d_out, CAP * 8, cudaMemcpyDeviceToHost), "d2h");
+        ck(cudaMemcpy(sb.data(), d_src_b, CAP * 8, cudaMemcpyDeviceToHost), "d2h");
+        bool ok = std::memcmp(a.data(), b.data(), a.size()) == 0 && std::memcmp(b.data(), host.data() ? b.data() : b.data(), 0) == 0;
+        for (int k = 0; k < n; ++k) {
+            ok = ok && pa[k] - (unsigned long long) d_dst_a == pb[k] - (unsigned long long) d_dst_b;   // the same offsets
+            ok = ok && std::memcmp(b.data() + (size_t) k * BLOB, host[k], BLOB) == 0;              // the right bytes
+        }
+        ok = ok && std::memcmp(sb.data(), srcp.data(), CAP * 8) == 0;   // the fused launch leaves the source pointers alone
+        if (!ok) {
+            ++fails;
+            int bad_ref = 0, bad_new = 0, bad_ptr = 0;
+            for (int k = 0; k < n; ++k) {
+                bad_ref += std::memcmp(a.data() + (size_t) k * BLOB, host[k], BLOB) != 0;
+                bad_new += std::memcmp(b.data() + (size_t) k * BLOB, host[k], BLOB) != 0;
+                bad_ptr += pa[k] - (unsigned long long) d_dst_a != pb[k] - (unsigned long long) d_dst_b;
+            }
+            std::fprintf(stderr, "FAIL n=%d: two-launch blobs wrong %d, fused blobs wrong %d, pointer offsets differ %d, src kept %d\n",
+                         n, bad_ref, bad_new, bad_ptr, (int) (std::memcmp(sb.data(), srcp.data(), CAP * 8) == 0));
+        }
+    }
+    std::printf("fetch_rebase_parity: %d counts, %d failures\n", CAP + 1, fails);
+    return fails == 0 ? 0 : 1;
+}
diff --git a/src/kernels/route_bell_parity.cpp b/src/kernels/route_bell_parity.cpp
new file mode 100644
index 000000000..58d9620aa
--- /dev/null
+++ b/src/kernels/route_bell_parity.cpp
@@ -0,0 +1,95 @@
+// src/kernels/route_bell_parity.cpp - [claude] E759 STRATA_ROUTE_BELL: the router with the doorbell folded in
+// (native_router_top10_multi_bell) against the two launches it replaces (native_router_top10_multi, then
+// doorbell_publish), for n = 1..8 tokens, on plain logits, on logits with exact ties and on logits with NaN.
+// Compared with memcmp: the device ids / weights, and the mapped (host) x / ids / weights the CPU pool reads; the
+// ring must have gone up by exactly one in each path.
+#include "strata/kernels/elementwise.hpp"
+#include "strata/kernels/native_router.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace {
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e));
+        std::exit(1);
+    }
+}
+constexpr int NE = 512, K = 10, N = 2560, MAXT = 8;
+
+struct Mapped {   // a host buffer the GPU writes through its mapped pointer, as the engine's doorbell rows
+    void* h = nullptr;
+    void* d = nullptr;
+    explicit Mapped(size_t bytes) {
+        ck(cudaHostAlloc(&h, bytes, cudaHostAllocMapped), "cudaHostAlloc");
+        ck(cudaHostGetDevicePointer(&d, h, 0), "cudaHostGetDevicePointer");
+        std::memset(h, 0, bytes);
+    }
+    ~Mapped() { cudaFreeHost(h); }
+};
+}  // namespace
+
+int main() {
+    cudaStream_t st = nullptr;
+    ck(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking), "stream");
+    float *d_logits = nullptr, *d_x = nullptr, *d_wa = nullptr, *d_wb = nullptr;
+    int32_t *d_ida = nullptr, *d_idb = nullptr;
+    ck(cudaMalloc(&d_logits, (size_t) MAXT * NE * 4), "malloc");
+    ck(cudaMalloc(&d_x, (size_t) MAXT * N * 4), "malloc");
+    ck(cudaMalloc(&d_wa, MAXT * K * 4), "malloc");
+    ck(cudaMalloc(&d_wb, MAXT * K * 4), "malloc");
+    ck(cudaMalloc(&d_ida, MAXT * K * 4), "malloc");
+    ck(cudaMalloc(&d_idb, MAXT * K * 4), "malloc");
+    Mapped xa((size_t) MAXT * N * 4), xb((size_t) MAXT * N * 4), ia(MAXT * K * 4), ib(MAXT * K * 4), wa(MAXT * K * 4),
+        wb(MAXT * K * 4), sa(64), sb(64);
+    std::mt19937 rng(11);
+    std::normal_distribution<float> nd(0.0f, 2.0f);
+    int fails = 0, cases = 0;
+    for (int kind = 0; kind < 3; ++kind) {
+        for (int n = 1; n <= MAXT; ++n) {
+            for (int rep = 0; rep < 4; ++rep) {
+                std::vector<float> lg((size_t) n * NE), x((size_t) n * N);
+                for (auto& v : lg) v = nd(rng);
+                if (kind == 1)   // exact ties: the smallest index must win in both paths
+                    for (int t = 0; t < n; ++t)
+                        for (int e = 0; e < NE; e += 7) lg[(size_t) t * NE + e] = 3.0f;
+                if (kind == 2)
+                    for (int t = 0; t < n; ++t) lg[(size_t) t * NE + (t * 37) % NE] = NAN;
+                for (auto& v : x) v = nd(rng);
+                ck(cudaMemcpy(d_logits, lg.data(), lg.size() * 4, cudaMemcpyHostToDevice), "h2d");
+                ck(cudaMemcpy(d_x, x.data(), x.size() * 4, cudaMemcpyHostToDevice), "h2d");
+                const uint32_t sa0 = *(volatile uint32_t*) sa.h, sb0 = *(volatile uint32_t*) sb.h;
+                strata::kernels::native_router_top10_multi(d_logits, d_ida, d_wa, n, st);
+                strata::kernels::doorbell_publish(d_x, d_ida, d_wa, (int64_t) n * N, (int64_t) n * K, (float*) xa.d,
+                                                  (int32_t*) ia.d, (float*) wa.d, (uint32_t*) sa.d, st);
+                strata::kernels::native_router_top10_multi_bell(d_logits, d_idb, d_wb, n, d_x, (int64_t) n * N, (float*) xb.d,
+                                                                (int32_t*) ib.d, (float*) wb.d, (uint32_t*) sb.d, st);
+                ck(cudaStreamSynchronize(st), "sync");
+                std::vector<int32_t> ha(n * K), hb(n * K);
+                std::vector<float> fa(n * K), fb(n * K);
+                ck(cudaMemcpy(ha.data(), d_ida, n * K * 4, cudaMemcpyDeviceToHost), "d2h");
+                ck(cudaMemcpy(hb.data(), d_idb, n * K * 4, cudaMemcpyDeviceToHost), "d2h");
+                ck(cudaMemcpy(fa.data(), d_wa, n * K * 4, cudaMemcpyDeviceToHost), "d2h");
+                ck(cudaMemcpy(fb.data(), d_wb, n * K * 4, cudaMemcpyDeviceToHost), "d2h");
+                ++cases;
+                bool ok = std::memcmp(ha.data(), hb.data(), n * K * 4) == 0 && std::memcmp(fa.data(), fb.data(), n * K * 4) == 0 &&
+                          std::memcmp(xa.h, xb.h, (size_t) n * N * 4) == 0 && std::memcmp(ia.h, ib.h, n * K * 4) == 0 &&
+                          std::memcmp(wa.h, wb.h, n * K * 4) == 0 && std::memcmp(xb.h, x.data(), (size_t) n * N * 4) == 0 &&
+                          *(volatile uint32_t*) sa.h == sa0 + 1 && *(volatile uint32_t*) sb.h == sb0 + 1;
+                if (!ok) {
+                    ++fails;
+                    std::fprintf(stderr, "FAIL kind %d n %d rep %d\n", kind, n, rep);
+                }
+            }
+        }
+    }
+    std::printf("route_bell_parity: %d cases, %d failures\n", cases, fails);
+    return fails == 0 ? 0 : 1;
+}
diff --git a/tests/program/vram_ledger_test.cpp b/tests/program/vram_ledger_test.cpp
new file mode 100644
index 000000000..a77c77e10
--- /dev/null
+++ b/tests/program/vram_ledger_test.cpp
@@ -0,0 +1,144 @@
+// tests/program/vram_ledger_test.cpp - scheduler step 2b: the per-card lending ledger (no GPU).
+#include "strata/program/vram_ledger.hpp"
+
+#include <cstdio>
+#include <random>
+#include <string>
+#include <vector>
+
+using namespace strata::program;
+using namespace strata::program::vram_ledger;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const std::string& what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what.c_str());
+    ++g_fail;
+}
+constexpr uint64_t MiB = 1ull << 20;
+const Lease& lease(const Card& c, int id) { return c.leases()[(size_t) id]; }
+}  // namespace
+
+int main() {
+    // 1. the tail loan is exactly the prompt path's loan today: split_lend_slots, uniform slots
+    {
+        const uint64_t blob = 1948 * 1024;   // ~1.86 MiB, the IQ3_S slot on this box
+        Card c(7025, {}, blob);
+        const uint64_t need = 900 * MiB;
+        const int id = c.lend_tail("prompt", need, 128);
+        const int64_t n = split_lend_slots(7025, (int64_t) (7025 * blob), nullptr, blob, need);
+        check(id >= 0 && lease(c, id).lo == 7025 - n && lease(c, id).hi == 7025, "uniform: the loan = split_lend_slots' tail");
+        check(c.expert_slots() == 7025 - n, "uniform: experts keep the rest");
+    }
+    // 2. ...and with per-slot sizes (a native pack), against random layouts
+    {
+        std::mt19937 rng(7);
+        for (int t = 0; t < 50; ++t) {
+            const int64_t slots = 500 + (int64_t) (rng() % 3000);
+            std::vector<uint64_t> off(1, 0);
+            for (int64_t i = 0; i < slots; ++i) off.push_back(off.back() + (1 + rng() % 4) * MiB);
+            Card c(slots, off, 0);
+            const uint64_t need = (uint64_t) (rng() % (off.back() / 2)) + 1;
+            const int64_t n = split_lend_slots(slots, (int64_t) off.back(), off.data(), 0, need);
+            const int id = c.lend_tail("prompt", need, 0);
+            if (slots - n < 0 || n == 0) continue;
+            check(id >= 0 && lease(c, id).lo == slots - n, "sized: the loan = split_lend_slots' tail (" + std::to_string(t) + ")");
+            check(c.bytes_of(slots) - c.bytes_of(lease(c, id).lo) >= need, "sized: the loan covers what was asked");
+        }
+    }
+    // 3. fixed regions stack from the head, only at start, within a budget
+    {
+        Card c(1000, {}, 2 * MiB);
+        const int a = c.reserve_head("slot sessions", 100 * MiB, 200);   // 50 slots
+        const int b = c.reserve_head("kv window", 60 * MiB, 200);        // 30 slots after it
+        check(a >= 0 && lease(c, a).lo == 0 && lease(c, a).hi == 50, "head 1 at [0, 50)");
+        check(b >= 0 && lease(c, b).lo == 50 && lease(c, b).hi == 80 && c.head_end() == 80, "head 2 stacked at [50, 80)");
+        check(c.reserve_head("too much", 300 * MiB, 200) < 0, "over the head budget: refused");
+        check(c.expert_slots() == 1000, "placed but not occupied: experts still use the head regions");
+        c.occupy(a);
+        check(c.expert_slots() == 950, "occupied: its slots leave the experts");
+        c.vacate(a);
+        check(c.expert_slots() == 1000, "vacated: back to the experts");
+        const int l = c.lend_tail("prompt", 10 * MiB, 0);
+        check(l >= 0 && c.reserve_head("late", 2 * MiB, 200) < 0, "no new fixed region once a loan is out");
+        c.release(l);
+        check(c.shrink_to(900) && c.reserve_head("late", 2 * MiB, 200) < 0, "no new fixed region after a shrink");
+    }
+    // 4. the loan keeps clear of the head regions (occupied or not) and leaves keep_min slots for experts
+    {
+        Card c(300, {}, 1 * MiB);
+        c.reserve_head("slot sessions", 50 * MiB, 100);   // [0, 50): the loan may start at 50 + keep_min at the lowest
+        check(c.lend_tail("prompt", 122 * MiB, 128) >= 0, "a loan leaving exactly 128 slots past the head: granted");
+    }
+    {
+        Card c(300, {}, 1 * MiB);
+        c.reserve_head("slot sessions", 50 * MiB, 100);
+        check(c.lend_tail("prompt", 123 * MiB, 128) < 0, "a loan leaving 127 slots past the head: refused");
+        check(c.lend_tail("prompt", 251 * MiB, 0) < 0, "a loan into the head region: refused");
+    }
+    // 5. sub-loans stack inside a loan and go back with it
+    {
+        Card c(1000, {}, 1 * MiB);
+        const int p = c.lend_tail("prompt", 400 * MiB, 128);   // [600, 1000)
+        check(p >= 0, "the loan [600, 1000)");
+        const int s1 = c.sub(p, "dp stage ring", 76 * MiB);
+        const int s2 = c.sub(p, "dp foreign session", 512 * MiB);
+        const int s3 = c.sub(p, "dp foreign session", 300 * MiB);
+        check(s1 >= 0 && lease(c, s1).lo == 600 && lease(c, s1).hi == 676, "sub 1 at the loan's low end");
+        check(s2 < 0, "a sub-loan larger than what is left of the loan: refused");
+        check(s3 >= 0 && lease(c, s3).lo == 676 && lease(c, s3).hi == 976, "sub 2 stacked after sub 1");
+        check(c.expert_slots() == 600, "sub-loans do not count twice");
+        c.release(p);
+        check(!lease(c, s1).active && !lease(c, s3).active && c.expert_slots() == 1000, "releasing the loan releases its sub-loans");
+        check(c.lend_tail("again", 10 * MiB, 0) >= 0, "a new loan after the release");
+    }
+    // 6. external room: only between loans, never below the head; the next loan follows the shorter tail
+    {
+        Card c(1000, {}, 1 * MiB);
+        c.reserve_head("slot sessions", 50 * MiB, 100);
+        const int p = c.lend_tail("prompt", 100 * MiB, 128);
+        check(!c.shrink_to(800), "shrink while a loan is out: refused");
+        c.release(p);
+        check(c.shrink_to(800) && c.live() == 800, "shrink between requests (the picture reader's room)");
+        check(!c.shrink_to(40), "shrink into the head regions: refused");
+        const int q = c.lend_tail("prompt", 100 * MiB, 128);
+        check(q >= 0 && lease(c, q).hi == 800 && lease(c, q).lo == 700, "the next loan takes the tail of what is left");
+        c.release(q);
+        check(c.shrink_to(5000) && c.live() == 1000, "grow back, clamped to the full cache");
+    }
+
+    // 7. several loans at once: stacked down from the tail, a released one leaves a gap the next fitting loan reuses
+    {
+        Card c(1000, {}, 1 * MiB);
+        const int a = c.lend_tail("slot A prompt", 200 * MiB, 128);   // [800, 1000): today's loan exactly
+        const int b = c.lend_tail("slot B prompt", 150 * MiB, 128);   // [650, 800)
+        const int k = c.lend_tail("kv growth", 100 * MiB, 128);       // [550, 650)
+        check(lease(c, a).lo == 800 && lease(c, a).hi == 1000, "loan 1 at the tail");
+        check(lease(c, b).lo == 650 && lease(c, b).hi == 800, "loan 2 stacked below it");
+        check(lease(c, k).lo == 550 && lease(c, k).hi == 650, "loan 3 below that");
+        check(c.expert_slots() == 550, "three loans out: 450 slots lent");
+        c.release(b);                                                   // a gap [650, 800)
+        const int d = c.lend_tail("small", 100 * MiB, 128);
+        check(d >= 0 && lease(c, d).lo == 700 && lease(c, d).hi == 800, "the next loan that fits reuses the gap, from its top");
+        const int e = c.lend_tail("big", 300 * MiB, 128);               // the gap left [650, 700) is too small
+        check(e >= 0 && lease(c, e).hi == 550 && lease(c, e).lo == 250, "a loan the gap cannot hold goes below the others");
+        check(!c.shrink_to(900), "no shrink while loans are out");
+    }
+    // 8. a short card: the experts' floor holds across all loans, and `available` says what still fits
+    {
+        Card c(600, {}, 2 * MiB);                                       // ~1.2 GB of cache on an 8 GB card
+        c.reserve_head("slot sessions", 100 * MiB, 100);                // [0, 50)
+        const int a = c.lend_tail("prompt", 600 * MiB, 16);             // 300 slots: [300, 600)
+        check(a >= 0, "the first loan fits");
+        const uint64_t room = c.available(16);                          // 600 - 50 - 16 - 300 = 234 slots
+        check(room == 234 * 2 * MiB, "available: what is left above the floor, in bytes");
+        check(c.lend_tail("second", room + 1, 16) < 0, "a loan above what is available: refused");
+        check(c.lend_tail("second", room, 16) >= 0, "a loan of exactly what is available: granted");
+        check(c.available(16) == 0, "nothing left above the floor");
+        check(c.expert_slots() == 66, "experts keep the floor (16) plus the head region while it is not occupied (50)");
+    }
+
+    if (g_fail == 0) std::printf("vram_ledger_test: all checks passed\n");
+    return g_fail == 0 ? 0 : 1;
+}
