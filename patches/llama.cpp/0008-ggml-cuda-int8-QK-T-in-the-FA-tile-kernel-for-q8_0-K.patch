     ggml_cuda_pool_alloc<float>  dst_tmp(pool);
@@ -1028,6 +1064,24 @@ void launch_fattn(
     size_t nb22 = V->nb[2];
     size_t nb23 = V->nb[3];
 
+    if (repack_K_q8) {
+        // E406: q8_0 K rows repacked to [ne10 int8 qs][ne10/32 half d] (272 bytes at D=256) in the f16 scratch
+        GGML_ASSERT(K->type == GGML_TYPE_Q8_0 && K->ne[0] % 32 == 0 && K->nb[0] == ggml_type_size(GGML_TYPE_Q8_0));
+        GGML_ASSERT(!V_is_K_view);
+        GGML_ASSERT(f16_extra.K != 0);
+        const int     nblk  = (int) (K->ne[0] / 32);
+        const int64_t total = K->ne[1]*K->ne[2]*K->ne[3]*nblk;
+        char * K_rp = (char *) f16_extra.K;
+        GGML_ASSERT(nblk <= 16 && (nblk*34) % 16 == 0);
+        const int64_t nrows = total / nblk;
+        fattn_repack_q8_0_rows<<<(unsigned) ((nrows + 7)/8), 256, 0, main_stream>>>(
+            K_data, K_rp, nblk, (int) K->ne[1], (int) K->ne[2], nrows, (int64_t) nb11, (int64_t) nb12, (int64_t) nb13);
+        CUDA_CHECK(cudaGetLastError());
+        K_data = K_rp;
+        nb11 = (size_t) nblk*34;
+        nb12 = (size_t) K->ne[1]*nb11;
+        nb13 = (size_t) K->ne[2]*nb12;
+    } else
     if (need_f16_K && K->type != GGML_TYPE_F16) {
         const size_t bs = ggml_blck_size(K->type);
         const size_t ts = ggml_type_size(K->type);
@@ -1135,6 +1189,11 @@ void launch_fattn(
     int max_blocks_per_sm = 1; // Max. number of active blocks limited by occupancy.
     CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&max_blocks_per_sm, fattn_kernel, block_dim.x * block_dim.y * block_dim.z, nbytes_shared));
     GGML_ASSERT(max_blocks_per_sm > 0);
+    // E409: the int8 tile kernel's smaller LDS footprint raises its occupancy to 2, which would route it through the
+    // split-KV + combine path (parallel_blocks > 1); that path cost it Max KLD 22 on Qwen3.8-27B (and the f16 kernel
+    // forced through it measured Max KLD 1.2 against 0.46), so the int8 path keeps one block per output tile, the same
+    // parallelism the f16 kernel gets on this card.
+    if (repack_K_q8) { max_blocks_per_sm = 1; }
     int parallel_blocks = max_blocks_per_sm;
 
     const int64_t n_kv = use_sparse ? n_kv_max : K->ne[1];
@@ -1304,4 +1363,28 @@ void launch_fattn(
             dst_tmp.ptr, dst_tmp_meta.ptr, (float *) KQV->data, parallel_blocks);
     }
     CUDA_CHECK(cudaGetLastError());
+    // E409 (local diagnostic): FATTN_DUMP_DIR=<dir> dumps the first 256 calls' outputs and launch geometry
+    {
+        static const char * dump_dir = getenv("FATTN_DUMP_DIR");
+        static int call = 0;
+        if (dump_dir && call < 256) {   // (run dumps with GGML_CUDA_DISABLE_GRAPHS=1: a sync inside a graph capture aborts)
+            CUDA_CHECK(cudaStreamSynchronize(main_stream));
+            const size_t nb = ggml_nbytes(KQV);
+            std::vector<char> host(nb);
+            CUDA_CHECK(cudaMemcpy(host.data(), KQV->data, nb, cudaMemcpyDeviceToHost));
+            char path[512];
+            snprintf(path, sizeof path, "%s/call-%03d.bin", dump_dir, call);
+            FILE * f = fopen(path, "wb"); if (f) { fwrite(host.data(), 1, nb, f); fclose(f); }
+            snprintf(path, sizeof path, "%s/index.txt", dump_dir);
+            f = fopen(path, "a");
+            if (f) {
+                fprintf(f, "call %03d dev %d Q %lld,%lld,%lld,%lld K %lld,%lld,%lld,%lld nb11 %zu ncols1 %d ncols2 %d blocks %u,%u,%u parallel_blocks %d stream_k %d KV_max %d\n",
+                    call, ggml_cuda_get_device(), (long long) Q->ne[0], (long long) Q->ne[1], (long long) Q->ne[2], (long long) Q->ne[3],
+                    (long long) K->ne[0], (long long) K->ne[1], (long long) K->ne[2], (long long) K->ne[3], nb11, ncols1, ncols2,
+                    blocks_num.x, blocks_num.y, blocks_num.z, parallel_blocks, (int) stream_k, KV_max.ptr != nullptr);
+                fclose(f);
+            }
+            ++call;
+        }
+    }
 }
diff --git a/ggml/src/ggml-cuda/fattn-tile.cuh b/ggml/src/ggml-cuda/fattn-tile.cuh
index b5ea915e1..3e94448f5 100644
--- a/ggml/src/ggml-cuda/fattn-tile.cuh
+++ b/ggml/src/ggml-cuda/fattn-tile.cuh
@@ -554,9 +554,96 @@ static __device__ __forceinline__ void flash_attn_tile_iter_KQ(
     }
 }
 
+// ================================ E406: int8 QK^T for q8_0 K on RDNA2 (gfx1030) ================================
+// K stays q8_0 (8 blocks of {half d; int8 qs[32]} per key, 272 bytes); Q is quantized to int8 per 32-dim block in
+// LDS; the dot products use v_dot4_i32_i8 (4 MACs per lane per instruction, half the LDS bytes per MAC of the
+// half2 path). Only instantiated for DKQ == 256 (see launch_fattn_tile_switch_ncols1); the rest is unchanged.
+#define FATTN_KQ8_ROW 272   // LDS bytes per key: 256 int8 qs (16-byte aligned), then the 8 half scales
+typedef int __attribute__((aligned(1))) fattn_int_ua;   // a dword at a 2-byte-aligned address (gfx9+: one load)
+
+// Copy nbatch_fa packed K rows (272 bytes each, contiguous: the host repacked them, stride == FATTN_KQ8_ROW) into
+// the LDS tile as one contiguous run of 16-byte chunks; rows beyond i_sup are zero.
+template<int nwarps, int nbatch_fa, bool oob_check>
+static __device__ __forceinline__ void fattn_kq8_load_K(
+        const char * __restrict__ K, char * __restrict__ tile, const int stride_K_bytes, const int i_sup) {
+    constexpr int nthreads = nwarps*32;
+    constexpr int cpr = FATTN_KQ8_ROW/16;          // chunks per row: 17
+    constexpr int nchunks = nbatch_fa*cpr;
+    const int t = threadIdx.y*32 + threadIdx.x;
+    GGML_UNUSED(stride_K_bytes);
+#pragma unroll
+    for (int c0 = 0; c0 < nchunks; c0 += nthreads) {
+        const int c = c0 + t;
+        if (c0 + nthreads <= nchunks || c < nchunks) {
+            if constexpr (oob_check) {
+                const int i = c / cpr;
+                *reinterpret_cast<int4 *>(tile + c*16) = i < i_sup ? *reinterpret_cast<const int4 *>(K + c*16) : make_int4(0, 0, 0, 0);
+            } else {
+                *reinterpret_cast<int4 *>(tile + c*16) = *reinterpret_cast<const int4 *>(K + c*16);
+            }
+        }
+    }
+}
+
+// KQ_acc[(i0/32)*cpw + jc0] += K[i0 + lane] . Q[jc] over all 256 dims, for the thread's keys and columns.
+template <int nwarps, int ncols, int nbatch_fa, bool oob_check>
+static __device__ __forceinline__ void fattn_kq8_iter_KQ(
+        const char * __restrict__ Q_q8, const float * __restrict__ Qd,
+        const char * __restrict__ K, char * __restrict__ tile, const int stride_K_bytes,
+        const int k_VKQ_0, const int k_VKQ_sup, float * KQ_acc) {
+    constexpr int cpw = ncols/nwarps;
+    constexpr int kpt = nbatch_fa/32;      // keys per thread
+    fattn_kq8_load_K<nwarps, nbatch_fa, oob_check>(K + int64_t(k_VKQ_0)*stride_K_bytes, tile, stride_K_bytes, k_VKQ_sup);
+    __syncthreads();
+#pragma unroll
+    for (int b = 0; b < 8; ++b) {
+        int sumi[kpt][cpw];   // one int32 sum per (key, column) over the 32-dim block, 8 chained v_dot4
+#pragma unroll
+        for (int i0 = 0; i0 < kpt; ++i0) {
+#pragma unroll
+            for (int jc0 = 0; jc0 < cpw; ++jc0) {
+                sumi[i0][jc0] = 0;
+            }
+        }
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            int4 kq[kpt];
+            int4 qq[cpw];
+#pragma unroll
+            for (int i0 = 0; i0 < kpt; ++i0) {
+                kq[i0] = *reinterpret_cast<const int4 *>(tile + (i0*32 + threadIdx.x)*FATTN_KQ8_ROW + b*32 + h*16);
+            }
+#pragma unroll
+            for (int jc0 = 0; jc0 < cpw; ++jc0) {
+                qq[jc0] = *reinterpret_cast<const int4 *>(Q_q8 + (threadIdx.y*cpw + jc0)*256 + b*32 + h*16);
+            }
+#pragma unroll
+            for (int i0 = 0; i0 < kpt; ++i0) {
+#pragma unroll
+                for (int jc0 = 0; jc0 < cpw; ++jc0) {
+                    sumi[i0][jc0] = ggml_cuda_dp4a(kq[i0].x, qq[jc0].x, sumi[i0][jc0]);
+                    sumi[i0][jc0] = ggml_cuda_dp4a(kq[i0].y, qq[jc0].y, sumi[i0][jc0]);
+                    sumi[i0][jc0] = ggml_cuda_dp4a(kq[i0].z, qq[jc0].z, sumi[i0][jc0]);
+                    sumi[i0][jc0] = ggml_cuda_dp4a(kq[i0].w, qq[jc0].w, sumi[i0][jc0]);
+                }
+            }
+        }
+        // fold: the K block scale (q8_0 d, half) and the Q block scale, read from LDS (keeping them in VGPRs spilled)
+#pragma unroll
+        for (int i0 = 0; i0 < kpt; ++i0) {
+            const float dk = __half2float(*reinterpret_cast<const half *>(tile + (i0*32 + threadIdx.x)*FATTN_KQ8_ROW + 256 + 2*b));
+#pragma unroll
+            for (int jc0 = 0; jc0 < cpw; ++jc0) {
+                KQ_acc[i0*cpw + jc0] += dk*Qd[(threadIdx.y*cpw + jc0)*8 + b]*float(sumi[i0][jc0]);
+            }
+        }
+    }
+    __syncthreads();   // the tile is reused for V
+}
+
 // Function that performs a single iteration of the main loop over up to nbatch_fa tokens.
 template <int warp_size, int nwarps, int ncols1, int ncols2, int DKQ, int DV, int nbatch_fa, int nbatch_K,
-    bool use_logit_softcap, bool oob_check, typename T_vec_dot, typename T_KQ, typename T_acc>
+    bool use_logit_softcap, bool oob_check, bool KQ8 = false, typename T_vec_dot = half2, typename T_KQ = half, typename T_acc = half2>
 static __device__ __forceinline__ void flash_attn_tile_iter(
         T_vec_dot * const Q_tmp,
         const half2 * const __restrict__ K_h2,
@@ -604,6 +691,14 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
     float KQ_acc[nbatch_fa/(np*warp_size) * cpw] = {0.0f}; // Accumulators for KQ matrix multiplication.
 
     // KQ = K @ Q matrix multiplication:
+    if constexpr (KQ8) {
+        static_assert(DKQ == 256 && np == 1, "int8 QK: DKQ 256, one warp per column group");
+        const char  * Q_q8 = reinterpret_cast<const char *>(Q_tmp);
+        const float * Qd   = reinterpret_cast<const float *>(Q_q8 + ncols*256);
+        fattn_kq8_iter_KQ<nwarps, ncols, nbatch_fa, oob_check>(
+            Q_q8, Qd, reinterpret_cast<const char *>(K_h2), reinterpret_cast<char *>(KV_tmp), stride_K2*int(sizeof(half2)),
+            k_VKQ_0, k_VKQ_sup, KQ_acc);
+    } else {
     constexpr int nbatch_K_last = DKQ % nbatch_K;
 #pragma unroll
     for (int k_KQ_0 = 0; k_KQ_0 < DKQ - nbatch_K_last; k_KQ_0 += nbatch_K) {
@@ -615,6 +710,7 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
         flash_attn_tile_iter_KQ<warp_size, nwarps, ncols1, ncols2, DKQ, nbatch_fa, nbatch_K_last, use_logit_softcap, oob_check>(
             Q_tmp, K_h2, KV_tmp, stride_K2, k_VKQ_0, k_VKQ_sup, k_KQ_0, KQ_acc);
     }
+    }
 
     // Apply logit softcap + mask, update KQ_max:
 #pragma unroll
@@ -710,6 +806,7 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
         }
     }
 
+#if !defined(FATTN_SKIP_PV)
     // VKQ = V @ KQ matrix multiplication:
     static_assert(DV <= DKQ, "bad DV");
     static_assert(DV % nbatch_K == 0 || (nbatch_K % 3 == 0 && DV % (nbatch_K*2/3) == 0), "bad nbatch_K");
@@ -786,9 +883,10 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
 
         __syncthreads();
     }
+#endif // FATTN_SKIP_PV (E406 timing only)
 }
 
-template<int DKQ, int DV, int ncols1, int ncols2, bool use_logit_softcap> // D == head size
+template<int DKQ, int DV, int ncols1, int ncols2, bool use_logit_softcap, bool KQ8 = false> // D == head size
 __launch_bounds__(ggml_cuda_fattn_tile_get_nthreads(DKQ, DV, ncols1*ncols2), ggml_cuda_fattn_tile_get_occupancy(DKQ, DV, ncols1*ncols2))
 static __global__ void flash_attn_tile(
         const char * Q_ptr,
@@ -882,7 +980,9 @@ static __global__ void flash_attn_tile(
     // KQ == SRAM buffer to hold KQ fragments between KQ and VKQ matrix multiplications.
     // VKQ == Accumulators in registers for the final VKQ result.
 #ifdef FAST_FP16_AVAILABLE
-    __shared__ half2 Q_tmp[ncols * DKQ/2];
+    __shared__ half2 Q_tmp[KQ8 ? 8 : ncols * DKQ/2];
+    __shared__ __align__(16) char Q_q8buf[KQ8 ? ncols*256 + ncols*8*int(sizeof(float)) : 16];   // E406: int8 Q + a scale per 32-dim block
+    static_assert(!KQ8 || nbatch_fa*(nbatch_K/2 + cpy_ne)*int(sizeof(half2)) >= nbatch_fa*FATTN_KQ8_ROW, "int8 K tile must fit KV_tmp");
     __shared__ half2 KV_tmp[nbatch_fa * (nbatch_K/2 + cpy_ne) + DVp-DV];
     __shared__ half  KQ[ncols * nbatch_fa];
     __align__(16) half2 VKQ[cpw * ((DVp/2)/warp_size)] = {{0.0f, 0.0f}};
@@ -903,6 +1003,38 @@ static __global__ void flash_attn_tile(
     ggml_cuda_pdl_sync();
 
     // Load Q data, convert to FP16 if fast:
+    if constexpr (KQ8) {
+        // E406: thread t quantizes block b = t % 8 of column jc = t / 8 (ncols*8 == nthreads) to int8, scale per block
+        static_assert(ncols*8 == nwarps*warp_size, "int8 Q: one 32-dim block per thread");
+        const int t  = threadIdx.y*warp_size + threadIdx.x;
+        const int jc = t / 8, b = t % 8;
