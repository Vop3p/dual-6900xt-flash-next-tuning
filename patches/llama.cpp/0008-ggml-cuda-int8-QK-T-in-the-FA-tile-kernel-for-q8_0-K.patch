--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -1,6 +1,8 @@
 #pragma once
 
 #include "common.cuh"
+#include <vector>
+#include <cstdio>
 #include "convert.cuh"
 #include "vecdotq.cuh"
 
@@ -977,11 +979,45 @@ static __global__ void flash_attn_combine_results(
     dst[tid] = VKQ_numerator / VKQ_denominator;
 }
 
+// E406: one warp per K row - the q8_0 row (nblk blocks of 34 bytes) is read with 16-byte coalesced loads into LDS,
+// then written out as [nblk*32 int8 qs][nblk half d] with 4-byte coalesced stores (the int8 tile path's layout)
+typedef int __attribute__((aligned(1))) fattn_rp_int_ua;
+static __global__ void fattn_repack_q8_0_rows(
+        const char * __restrict__ src, char * __restrict__ dst, const int nblk, const int ne11, const int ne12, const int64_t nrows,
+        const int64_t nb11, const int64_t nb12, const int64_t nb13) {
+    __shared__ __align__(16) char buf[8][34*16 + 16];   // up to 16 blocks (D 512) per row, 8 rows per block
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+    const int64_t row = int64_t(blockIdx.x)*8 + warp;
+    const int rowb = nblk*34;
+    if (row < nrows) {
+        const int     i1 = int(row % ne11);
+        const int64_t r2 = row / ne11;
+        const int     i2 = int(r2 % ne12);
+        const int64_t i3 = r2 / ne12;
+        const char * s = src + i3*nb13 + i2*nb12 + int64_t(i1)*nb11;
+        for (int c = lane; c*16 < rowb; c += 32) {
+            *reinterpret_cast<int4 *>(buf[warp] + c*16) = *reinterpret_cast<const int4 *>(s + c*16);
+        }
+    }
+    __syncthreads();
+    if (row >= nrows) {
+        return;
+    }
+    char * d = dst + row*int64_t(rowb);
+    for (int j = lane; j < nblk*8; j += 32) {
+        const int b = j >> 3, k = j & 7;
+        *reinterpret_cast<int *>(d + 4*j) = *reinterpret_cast<const fattn_rp_int_ua *>(buf[warp] + 34*b + 2 + 4*k);
+    }
+    if (lane < nblk) {
+        *reinterpret_cast<unsigned short *>(d + nblk*32 + 2*lane) = *reinterpret_cast<const unsigned short *>(buf[warp] + 34*lane);
+    }
+}
+
 template <int DV, int ncols1, int ncols2>
 void launch_fattn(
     ggml_backend_cuda_context & ctx, ggml_tensor * dst, fattn_kernel_t fattn_kernel, const int nwarps, const size_t nbytes_shared,
     const int nbatch_fa, const bool need_f16_K, const bool need_f16_V, const bool stream_k, const bool use_sparse,
-    const int warp_size = WARP_SIZE
+    const int warp_size = WARP_SIZE, const bool repack_K_q8 = false
 ) {
