+    const int   * y_qs = (const int   *) y + 4;
+
+// #pragma unroll
+    for (int k01 = 0; k01 < MMQ_TILE_NE_K; k01 += QR5_K*VDR_Q5_K_Q8_1_MMQ) {
+        const int k0 = k00 + k01;
+
+#pragma unroll
+        for (int j0 = 0; j0 < J; j0 += nwarps) {
+            const int j = j0 + threadIdx.y;
+
+            const float     d8 = __int_as_float(y[j*MMQ_TILE_Y_K]);
+            const int16_t * bs = (const int16_t *) (y + j*MMQ_TILE_Y_K + 1) + k01/8;
+
+#pragma unroll
+            for (int i0 = 0; i0 < I; i0 += warp_size) {
+                const int i = i0 + threadIdx.x;
+
+                const uint8_t * sc = ((const uint8_t *) &x_sc[i * (MMQ_TILE_NE_K/8) + i/8 + k00/32]) + 2*(k01/16);
+
+                int sumi = 0;
+                int summ = 0;
+                vec_dot_q5_K_q8_K_impl_mmq(
+                    &x_qs[i*(QR5_K*MMQ_TILE_NE_K + 1) + k0], &y_qs[j*MMQ_TILE_Y_K + k01], sc, sc+8, bs, sumi, summ);
+
+                const float2 dm = __half22float2(x_dm[i]);
+                sum[j0/nwarps*I/warp_size + i0/warp_size] += d8 * (dm.x*sumi - dm.y*summ);
+            }
+        }
+    }
+}
