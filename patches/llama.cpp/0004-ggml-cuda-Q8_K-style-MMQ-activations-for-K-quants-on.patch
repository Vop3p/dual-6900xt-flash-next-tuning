+// GGML_CUDA_MMQ_Q8K: the y data has 1 scale per 256 values (block_q8_1_mmq::dk), so the K-quant sub-block scales stay in
+// the integer domain: sumi += sc*dot and summ += m*bsum over the 64 values of one call, 1 float conversion per call.
+// Operand bounds for the 24 bit multiplies: sc, m <= 63 (Q6_K: |sc| <= 127), |dot| <= 32*31*127, |bsum| <= 32*127.
+
+// contiguous v/x + u/y values, 2 sub-blocks of 32 values
+static __device__ __forceinline__ void vec_dot_q4_K_q8_K_impl_mmq(
+    const int * __restrict__ v, const int * __restrict__ u, const uint8_t * __restrict__ sc,
+    const uint8_t * __restrict__ m, const int16_t * __restrict__ bs, int & sumi, int & summ) {
+
+#pragma unroll
+    for (int i = 0; i < QR4_K*VDR_Q4_K_Q8_1_MMQ/QI8_1; ++i) {
+        int sumi_d = 0;
+
+#pragma unroll
+        for (int j = 0; j < QI8_1; ++j) {
+            sumi_d = ggml_cuda_dp4a((v[j] >> (4*i)) & 0x0F0F0F0F, u[i*QI8_1 + j], sumi_d); // SIMD dot product
+        }
+
+        sumi = ggml_cuda_mad_scale(sc[i], sumi_d, sumi);
+        summ = ggml_cuda_mad_scale( m[i],  bs[i], summ);
+    }
+}
